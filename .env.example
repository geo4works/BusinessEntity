IDENTITY_INITIAL_ISSUER=https://192.168.55.15:9441/
IDENTITY_INITIAL_METADATA=https://192.168.55.15:9441/.well-known/openid-configuration
IDENTITY_INITIAL_CLIENT_ID=business-entity-ui
IDENTITY_CLIENT_SECRET_A=__CONFIGURE__
IDENTITY_INITIAL_BACKCHANNEL=
IDENTITY_INITIAL_PROVISIONING=None
IDENTITY_INITIAL_MANAGEMENT=
IDENTITY_MANAGED_LOCAL=false
IDENTITY_BOOTSTRAP_ADMIN_ISSUER=https://192.168.55.15:9441/
