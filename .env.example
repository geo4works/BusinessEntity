# Reference for the root development stack. Generate local files with:
# ./Powershell/Initialize-AuthentikEnv.ps1
# __GENERATE__ values are replaced by the initializer before Docker starts.
PG_DB=authentik
PG_USER=authentik
PG_PASS=__GENERATE__
AUTHENTIK_SECRET_KEY=__GENERATE__
AUTHENTIK_IMAGE=ghcr.io/goauthentik/server
AUTHENTIK_TAG=2026.2.1
COMPOSE_PORT_HTTP=9000
COMPOSE_PORT_HTTPS=9443
AUTHENTIK_BASE_URL_FOR_BROWSER=http://localhost:9000
AUTHENTIK_REDIRECT_URIS=http://localhost:7000/auth/callback
AUTHENTIK_BOOTSTRAP_EMAIL=akadmin@businessentity.local
AUTHENTIK_BOOTSTRAP_PASSWORD=akadmin
AUTHENTIK_BOOTSTRAP_TOKEN=__GENERATE__
AUTHENTIK_CLIENT_ID=business-entity
AUTHENTIK_CLIENT_SECRET=__GENERATE__
AUTHENTIK_APPLICATION_NAME=BusinessEntity
AUTHENTIK_APPLICATION_USERS_GROUP=GeoUsers
AUTHENTIK_GENERAL_ADMINS_GROUP=BusinessEntityAdmins
# Optional existing Admin API token; otherwise the bootstrap token is used.
AUTHENTIK_API_TOKEN=
ENSURE_AUTHENTIK_ON_STARTUP=true
