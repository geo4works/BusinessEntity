# BusinessEntity connects to an independently installed identity environment.
USER_HUB_URL=https://192.168.55.15:9440

# Select a separate empty application DB/storage for AUTH_001; never delete the old installation.
BUSINESS_ENTITY_CONNECTION=Host=postgres-production-db;Port=5432;Database=business_entity_identity;Username=adm01;Password=__CONFIGURE__
BUSINESS_ENTITY_STORAGE_PATH=./BusinessEntityIdentityStorage
BUSINESS_ENTITY_STORAGE_HOST_ROOT=C:/Develop/BusinessEntityProduct/BusinessEntity/BusinessEntityIdentityStorage
IDENTITY_INITIAL_PROVIDER_ID=00000000-0000-0000-0000-000000000001
