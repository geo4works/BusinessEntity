ASPNETCORE_ENVIRONMENT=Production

BE_IMAGE=__BE_IMAGE__
WEB_LOGGER_IMAGE=__WEB_LOGGER_IMAGE__
POSTGRES_PRODUCTION_IMAGE=__POSTGRES_PRODUCTION_IMAGE__
AUTHENTIK_IMAGE=ghcr.io/goauthentik/server
AUTHENTIK_TAG=2026.2.1
AUTHENTIK_POSTGRES_IMAGE=postgres:16-alpine

BUSINESSENTITY_HTTP_PORT=7000
WEB_LOGGER_HTTP_PORT=5080
AUTHENTIK_HTTP_PORT=9000
AUTHENTIK_HTTPS_PORT=9443
BE_POSTGRES_PORT=5470
DOCKER_NETWORK_NAME=docker-business-entity-common-bridge

BE_POSTGRES_INITIAL_DB=main
BE_DB_NAME=business_entity
WEB_LOGGER_DB_NAME=web_logger
BE_DB_USER=adm01
BE_DB_PASSWORD=__GENERATE__

AUTHENTIK_PG_DB=authentik
AUTHENTIK_PG_USER=authentik
AUTHENTIK_PG_PASS=__GENERATE__
AUTHENTIK_SECRET_KEY=__GENERATE__
AUTHENTIK_DEFAULT_LOCALE=en
AUTHENTIK_BASE_URL_FOR_BROWSER=http://localhost:9000
AUTHENTIK_REDIRECT_URIS=http://localhost:7000/auth/callback
AUTHENTIK_BOOTSTRAP_EMAIL=akadmin@businessentity.local
AUTHENTIK_BOOTSTRAP_PASSWORD=akadmin
AUTHENTIK_BOOTSTRAP_TOKEN=__GENERATE__
AUTHENTIK_CLIENT_ID=business-entity
AUTHENTIK_CLIENT_SECRET=__GENERATE__
AUTHENTIK_APPLICATION_NAME=BusinessEntity
AUTHENTIK_APPLICATION_USERS_GROUP=GeoUsers
AUTHENTIK_GENERAL_ADMINS_GROUP=BusinessEntityAdmins
# Optional existing Admin API token; by default the application uses the bootstrap token.
AUTHENTIK_API_TOKEN=
ENSURE_AUTHENTIK_ON_STARTUP=true

STORAGE_HOST_ROOT_PATH=./storage
