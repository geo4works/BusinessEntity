{"version":1,"sourceRoot":"","destinationRoot":"","excludes":[],"expandedNodes":[],"nameExcludes":[],"showResultInFolder":false,"cleanDestinationBeforeCopy":false,"replicas":[],"variables":[{"alias":"{vpn-g05-username}","value":"","description":"Имя пользователя корпоративного VPN G05 (только локально, DPAPI).","isSecret":true,"secretId":"d58528b4-141b-4e11-939f-329f4d445e79"},{"alias":"{vpn-g05-password}","value":"","description":"Пароль корпоративного VPN G05 (только локально, DPAPI).","isSecret":true,"secretId":"041a4467-032a-4ed3-b4a4-608d1fb48bae"}],"remoteActions":{"logListener":false,"listenerPeriodSeconds":1},"notes":"BusinessEntity: existing User Hub, HTTPS7070, admin. New isolated scenario; User Hub commands are not included.","scriptExecutionPatterns":[{"alias":"BUSINESSENTITY-STATUS","description":"Read only phase, owned containers and build processes on 192.168.55.15","timeoutSeconds":180,"scriptBody":"$script:UserHubVpnUser = @'\n{vpn-g05-username}\n'@\n$script:UserHubVpnPassword = @'\n{vpn-g05-password}\n'@\n$script:UserHubVpnUser = $script:UserHubVpnUser.Trim()\n$script:UserHubVpnPassword = $script:UserHubVpnPassword.TrimEnd([char]13,[char]10)\nif (-not ('UserHubRasNative' -as [type])) {\n    Add-Type -TypeDefinition @'\nusing System;\nusing System.Runtime.InteropServices;\n\n// Shared by the managed deployer and its generated PowerShell preflight.\n// The existing G05 phonebook entry supplies server, PSK and routing. Only the\n// already configured client-vault username/password are supplied in memory.\npublic static class UserHubRasNative\n{\n    [StructLayout(LayoutKind.Sequential, CharSet = CharSet.Unicode)]\n    private struct DialParameters\n    {\n        public uint Size;\n        [MarshalAs(UnmanagedType.ByValTStr, SizeConst = 257)] public string Entry;\n        [MarshalAs(UnmanagedType.ByValTStr, SizeConst = 129)] public string Phone;\n        [MarshalAs(UnmanagedType.ByValTStr, SizeConst = 129)] public string Callback;\n        [MarshalAs(UnmanagedType.ByValTStr, SizeConst = 257)] public string Username;\n        [MarshalAs(UnmanagedType.ByValTStr, SizeConst = 257)] public string Password;\n        [MarshalAs(UnmanagedType.ByValTStr, SizeConst = 16)] public string Domain;\n        public uint Subentry;\n        public UIntPtr CallbackId;\n        public uint InterfaceIndex;\n    }\n    [DllImport(\"rasapi32.dll\", CharSet = CharSet.Unicode, EntryPoint = \"RasDialW\")]\n    private static extern uint RasDial(IntPtr extensions, string phonebook, ref DialParameters parameters,\n        uint notifierType, IntPtr notifier, out IntPtr connection);\n    [DllImport(\"rasapi32.dll\", EntryPoint = \"RasHangUpW\")]\n    private static extern uint RasHangUp(IntPtr connection);\n    public static uint Dial(string username, string password)\n    {\n        if (string.IsNullOrWhiteSpace(username) || string.IsNullOrEmpty(password) || username.Length > 256 || password.Length > 256) return 87;\n        var parameters = new DialParameters {Entry = \"G05\", Phone = \"\", Callback = \"\", Username = username, Password = password, Domain = \"\"};\n        parameters.Size = (uint)Marshal.SizeOf<DialParameters>();\n        var code = RasDial(IntPtr.Zero, null!, ref parameters, 0, IntPtr.Zero, out var connection);\n        parameters.Username = \"\"; parameters.Password = \"\";\n        if (code != 0 && connection != IntPtr.Zero) RasHangUp(connection);\n        // A successful connection deliberately remains available for the user's environment.\n        return code;\n    }\n}\n\n'@\n}\n# Shared client-side guard. Reuses the existing G05 profile and credentials from the existing client vault.\n# It never creates/edits a VPN profile, WireGuard configuration or explicit routes.\nfunction Test-UserHubServerReachable {\n    foreach ($port in @(22,8443)) {\n        $tcp = [Net.Sockets.TcpClient]::new()\n        try { $pending = $tcp.ConnectAsync('192.168.55.15',$port); if ($pending.Wait(2500) -and $tcp.Connected) { return $true } }\n        catch { }\n        finally { $tcp.Dispose() }\n    }\n    return $false\n}\nfunction Invoke-UserHubRasdial([bool]$disconnect) {\n    $start = [Diagnostics.ProcessStartInfo]::new()\n    $start.FileName = Join-Path $env:SystemRoot 'System32\\rasdial.exe'\n    $start.Arguments = $(if ($disconnect) {'G05 /disconnect'} else {'G05'})\n    $start.UseShellExecute = $false; $start.CreateNoWindow = $true\n    $start.RedirectStandardOutput = $true; $start.RedirectStandardError = $true; $start.RedirectStandardInput = $true\n    $process = [Diagnostics.Process]::Start($start)\n    try {\n        $process.StandardInput.Close() # No interactive username/password prompts.\n        $stdout = $process.StandardOutput.ReadToEndAsync(); $stderr = $process.StandardError.ReadToEndAsync()\n        if (-not $process.WaitForExit(60000)) { $process.Kill(); return -1 }\n        $null = $stdout.GetAwaiter().GetResult(); $null = $stderr.GetAwaiter().GetResult()\n        return $process.ExitCode\n    } finally { $process.Dispose() }\n}\nfunction Ensure-UserHubVpn {\n    if (Test-UserHubServerReachable) { return @{success=$true; action='already-reachable'; profile='G05'} }\n    $mutex = [Threading.Mutex]::new($false, 'Local\\UserHub.G05.NetworkGuard')\n    $owned = $false\n    try {\n    try { $owned=$mutex.WaitOne([TimeSpan]::FromSeconds(90)) } catch [Threading.AbandonedMutexException] { $owned=$true }\n    if (-not $owned) { return @{success=$false;action='guard-busy';profile='G05'} }\n    if (Test-UserHubServerReachable) { return @{success=$true; action='already-reachable'; profile='G05'} }\n    # The user explicitly authorized reconnecting this existing corporate VPN on loss.\n    $null = Invoke-UserHubRasdial $true\n    $code = [UserHubRasNative]::Dial($script:UserHubVpnUser, $script:UserHubVpnPassword)\n    if ($code -ne 0) { return @{success=$false; action='connect-failed'; profile='G05'; code=$code} }\n    $until = [DateTime]::UtcNow.AddSeconds(30)\n    do {\n        if (Test-UserHubServerReachable) { return @{success=$true; action='reconnected'; profile='G05'} }\n        Start-Sleep -Milliseconds 750\n    } while ([DateTime]::UtcNow -lt $until)\n    return @{success=$false; action='server-unreachable-after-connect'; profile='G05'; code=0}\n    } finally { if($owned){$mutex.ReleaseMutex()};$mutex.Dispose() }\n}\n\n# Appended after the existing client001 VPN guard; placeholders are pinned on publication.\n$ErrorActionPreference = 'Stop'\n$out = '{output-folder}'\nNew-Item -ItemType Directory -Force $out | Out-Null\n$phase = 'validate-input'\n$ssh = $null\n$sftp = $null\n$remote = $null\n$completed = $false\ntry {\n    $commandName = '{input-string}'.Trim().TrimEnd(';')\n    if ($commandName -notin @('BUSINESSENTITY-STATUS','BUSINESSENTITY-INSTALL')) { throw 'Unknown command' }\n    $mode = if ($commandName -eq 'BUSINESSENTITY-INSTALL') { 'install' } else { 'inspect' }\n    $manifests = @(Get-ChildItem -LiteralPath '{input-folder}' -Filter manifest.json -File -Recurse)\n    if ($manifests.Count -ne 1) { throw 'Manifest count' }\n    $manifestPath = $manifests[0].FullName\n    if ((Get-FileHash $manifestPath -Algorithm SHA256).Hash -ne '1AB48678D05E7A805A13490CC18DC14A92DB4654967AF393BBE1BC1E09D83D71') { throw 'Manifest pin mismatch' }\n    $base = $manifests[0].DirectoryName\n    $manifest = Get-Content -LiteralPath $manifestPath -Raw | ConvertFrom-Json\n    foreach ($entry in $manifest.files.PSObject.Properties) {\n        if ($entry.Name -notin @('host_install.py','request.json','source.zip')) { throw 'Unexpected payload file' }\n        if ((Get-FileHash (Join-Path $base $entry.Name) -Algorithm SHA256).Hash.ToLowerInvariant() -ne $entry.Value) { throw 'Payload pin mismatch' }\n    }\n    $approval = ''\n    if ($mode -eq 'install') {\n        $review = Get-Content (Join-Path $base 'approved-plan.json') -Raw | ConvertFrom-Json\n        if (-not $review.success -or $review.approval -notmatch '^[a-f0-9]{64}$' -or $review.plan.payloadSha256 -ne $manifest.files.'source.zip') { throw 'Reviewed plan required' }\n        $approval = [string]$review.approval\n    }\n    $phase = 'connect-client001'\n    $vpn = Ensure-UserHubVpn\n    if (-not $vpn.success) { throw 'VPN unavailable' }\n    Add-Type -Path 'C:\\Develop\\code-base-enlighter\\3.7.0\\Renci.SshNet.dll'\n    $profiles = Get-Content (Join-Path $env:APPDATA 'Geo4WebDeployer\\hosts.json') -Raw | ConvertFrom-Json\n    $found = @($profiles.hosts | Where-Object { $_.hostName -eq '192.168.55.15' -and $_.port -eq 22 })\n    if ($found.Count -ne 1) { throw 'Host profile unavailable' }\n    $profile = $found[0]\n    if (-not ('BusinessEntityHostPin' -as [type])) {\n        Add-Type -TypeDefinition @'\npublic static class BusinessEntityHostPin {\n    // Bind both SSH and SFTP to the already verified target host key.\n    public static void Apply(object client) {\n        var ev = client.GetType().GetEvent(\"HostKeyReceived\");\n        ev.AddEventHandler(client, System.Delegate.CreateDelegate(ev.EventHandlerType, typeof(BusinessEntityHostPin).GetMethod(\"Verify\")));\n    }\n    public static void Verify(object sender, object e) {\n        var key = (byte[])e.GetType().GetProperty(\"HostKey\").GetValue(e);\n        var value = \"SHA256:\" + System.Convert.ToBase64String(System.Security.Cryptography.SHA256.HashData(key)).TrimEnd('=');\n        e.GetType().GetProperty(\"CanTrust\").SetValue(e, value == \"SHA256:QOuiJp4IdHFLDAuQIBM6zdTK4MLA6q+XMK4SR7shgeI\");\n    }\n}\n'@\n    }\n    $ssh = [Renci.SshNet.SshClient]::new('192.168.55.15',22,[string]$profile.userName,[string]$profile.password)\n    [BusinessEntityHostPin]::Apply($ssh)\n    $ssh.ConnectionInfo.Timeout = [TimeSpan]::FromSeconds(25)\n    $ssh.Connect()\n    $created = $ssh.RunCommand('mktemp -d /tmp/be-bot-XXXXXXXXXX')\n    $remote = $created.Result.Trim()\n    if ($created.ExitStatus -ne 0 -or $remote -notmatch '^/tmp/be-bot-[A-Za-z0-9]{10}$') { throw 'Remote staging failed' }\n    $phase = 'transfer-pinned-payload'\n    $sftp = [Renci.SshNet.SftpClient]::new('192.168.55.15',22,[string]$profile.userName,[string]$profile.password)\n    [BusinessEntityHostPin]::Apply($sftp)\n    $sftp.Connect()\n    foreach ($entry in $manifest.files.PSObject.Properties) {\n        $stream = [IO.File]::OpenRead((Join-Path $base $entry.Name))\n        try { $sftp.UploadFile($stream, \"$remote/$($entry.Name)\", $false) } finally { $stream.Dispose() }\n    }\n    $phase = \"host-$mode\"\n    $hashJson = $manifest.files | ConvertTo-Json -Compress\n    $hashBase64 = [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes($hashJson))\n    # All interpolated shell/Python values below are fixed enums, validated paths or base64.\n    $python = @\"\nimport json,pathlib,subprocess\nroot=pathlib.Path('/srv/businessentity')\nstate=json.loads((root/'installation.json').read_text()) if (root/'installation.json').is_file() else {}\np=subprocess.run(['docker','ps','-a','--filter','label=com.docker.compose.project=businessentity','--format','{{json .}}'],capture_output=True,text=True,timeout=20)\ncontainers=[]\nfor line in p.stdout.splitlines():\n d=json.loads(line);containers.append({k:d.get(k) for k in ('Names','State','Status','Ports','Image')})\nprocesses=[]\nfor proc in pathlib.Path('/proc').iterdir():\n if not proc.name.isdigit(): continue\n try:\n  name=(proc/'comm').read_text().strip()\n  if name in ('docker','buildkitd','dotnet','python3'):processes.append({'pid':int(proc.name),'name':name})\n except (OSError,PermissionError):pass\nlogs={}\nfor c in containers:\n if not c.get('Names','').startswith('businessentity-'):continue\n t=subprocess.run(['docker','logs','--tail','55',c['Names']],capture_output=True,text=True,timeout=15)\n log=(t.stdout+t.stderr)[-10000:]\n for key in ('clientSecret','dbPassword'):\n  if state.get(key):log=log.replace(state[key],'<redacted>')\n logs[c['Names']]=log\nchecks={}\ntry:\n import runpy\n lib=runpy.run_path(str(pathlib.Path('$remote')/'host_install.py'))\n hub=lib['Hub'](state['request'])\n for route in ('/','/auth/login'):\n  try:\n   status,headers,_=hub.http.request(state['request']['applicationOrigin']+route)\n   checks[route]={'status':status,'redirectPath':lib['urlsplit'](headers.get('Location','')).path}\n  except Exception as e:checks[route]={'errorType':type(e).__name__}\nexcept Exception as e:checks['errorType']=type(e).__name__\nprint(json.dumps({'success':p.returncode==0,'readOnly':True,'phase':state.get('phase','absent'),'installationId':state.get('installationId'),'containers':containers,'processes':processes,'checks':checks,'logs':logs}))\n\"@\n    $probe = $ssh.RunCommand('sudo -n true >/dev/null 2>&1')\n    $needsPassword = $probe.ExitStatus -ne 0\n    $remoteCommand = $ssh.CreateCommand($(if ($needsPassword) { \"sudo -S -p '' python3 -B -\" } else { 'sudo -n python3 -B -' }))\n    $remoteCommand.CommandTimeout = [TimeSpan]::FromMinutes(2)\n    $async = $remoteCommand.BeginExecute()\n    $inputStream = $remoteCommand.CreateInputStream()\n    $body = $(if ($needsPassword) { [string]$profile.password + \"`n\" } else { '' }) + $python\n    $bytes = [Text.Encoding]::UTF8.GetBytes($body)\n    $inputStream.Write($bytes, 0, $bytes.Length)\n    $inputStream.Dispose()\n    $remoteCommand.EndExecute($async)\n    $completed = $true\n    $result = $remoteCommand.Result | ConvertFrom-Json\n    if ($remoteCommand.ExitStatus -ne 0 -and $result.success) { throw 'Host status mismatch' }\n    $result | ConvertTo-Json -Depth 30 | Set-Content (Join-Path $out 'result.json') -Encoding utf8\n} catch {\n    @{success=$false;failedPhase=$phase;errorType=$_.Exception.GetType().Name;remoteCompletionKnown=$completed} |\n        ConvertTo-Json | Set-Content (Join-Path $out 'result.json') -Encoding utf8\n} finally {\n    if ($null -ne $sftp) { $sftp.Dispose() }\n    if ($null -ne $ssh) {\n        if ($completed -and $ssh.IsConnected -and $remote -match '^/tmp/be-bot-[A-Za-z0-9]{10}$') { $null = $ssh.RunCommand(\"rm -rf -- '$remote'\") }\n        $ssh.Dispose()\n    }\n}\n"}]}
