# Reference for Authentic/.env. Run ./Powershell/Initialize-AuthentikEnv.ps1
# from the repository root to generate both local environment files.
# Keep PG_PASS and AUTHENTIK_SECRET_KEY consistent with the root .env.
PG_DB=authentik
PG_USER=authentik
PG_PASS=__GENERATE__
AUTHENTIK_SECRET_KEY=__GENERATE__
AUTHENTIK_IMAGE=ghcr.io/goauthentik/server
AUTHENTIK_TAG=2026.2.1
COMPOSE_PORT_HTTP=9000
COMPOSE_PORT_HTTPS=9443
