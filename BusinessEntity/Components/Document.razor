@if (!string.IsNullOrWhiteSpace(SaveError))
{
    <div class="alert alert-danger document-save-error" role="alert">@SaveError</div>
}

<div class="document-shell">
    <div class="document-layout">
        <div class="document-layout__content">
            @if (!IsEditing)
            {
                <div class="py-2">
                    <h4 class="mb-3">@Entity?.Name</h4>
                    @if (string.IsNullOrWhiteSpace(ViewText))
                    {
                        <div class="alert alert-secondary mb-0">Нет содержимого.</div>
                    }
                    else
                    {
                        <pre style="white-space: pre-wrap; background:#f8f9fa; padding:12px; border-radius:6px; border:1px solid #e9ecef;">@ViewText</pre>
                    }
                </div>
            }
            else
            {
                <div class="py-2">
                    <input class="form-control mb-2" placeholder="Заголовок"
                           style="font-size: 1.5rem; font-weight: 500;"
                           @bind="EditTitle" @bind:event="oninput" />

                    <textarea class="form-control" rows="16" placeholder="Текст документа"
                              @bind="EditBody" @bind:event="oninput"></textarea>
                </div>
            }
        </div>

        <div class="document-layout__actions">
            <div class="document-actions" role="group" aria-label="Действия документа">
                @if (!IsEditing)
                {
                    @if (CanChangePublicFlag)
                    {
                        <label class="form-check form-check-inline mb-0">
                            <input class="form-check-input"
                                   type="checkbox"
                                   checked="@IsPublic"
                                   @onchange="HandlePublicChangedAsync" />
                            <span class="form-check-label">Общий</span>
                        </label>
                    }
                    @if (Entity != null)
                    {
                        <a class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1"
                           title="Печать"
                           href="@($"/print/{Entity.Id}")">
                            <span class="material-icons" aria-hidden="true">print</span>
                            <span>Печать</span>
                        </a>
                    }
                    @if (CanEdit)
                    {
                        <button class="btn btn-sm document-actions__edit-button"
                                title="Edit"
                                @onclick="EnterEditMode">
                            Edit
                        </button>
                    }
                    @if (CanDelete)
                    {
                        <button class="btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1"
                                title="Удалить"
                                @onclick="HandleDeleteRequestedAsync">
                            <span class="material-icons" aria-hidden="true">delete</span>
                            <span>Удалить</span>
                        </button>
                    }
                }
                else
                {
                    @if (CanChangePublicFlag)
                    {
                        <label class="form-check form-check-inline mb-0">
                            <input class="form-check-input"
                                   type="checkbox"
                                   checked="@IsPublic"
                                   @onchange="HandlePublicChangedAsync"
                                   disabled="@IsSaving" />
                            <span class="form-check-label">Общий</span>
                        </label>
                    }
                    <button class="btn btn-sm btn-primary" disabled="@IsSaving" @onclick="SaveAsync">
                        @(IsSaving ? "Сохранение..." : "Сохранить")
                    </button>
                    <button class="btn btn-sm btn-outline-secondary" disabled="@IsSaving" @onclick="CancelEdit">Отмена</button>
                    @if (CanDelete)
                    {
                        <button class="btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1"
                                title="Удалить"
                                disabled="@IsSaving"
                                @onclick="HandleDeleteRequestedAsync">
                            <span class="material-icons" aria-hidden="true">delete</span>
                            <span>Удалить</span>
                        </button>
                    }
                }
            </div>
        </div>
    </div>
</div>

@if (Entity != null && !IsEditing)
{
    <BusinessEntityCommentsSection BusinessEntityId="@Entity.Id"
                                   CanWrite="true" />
}
