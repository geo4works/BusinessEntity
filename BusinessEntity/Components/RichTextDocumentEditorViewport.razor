@using BusinessEntity.Core.RichText
@using Microsoft.AspNetCore.Components
@implements IAsyncDisposable

<div class="rich-text-document-editor">
    <div class="rich-text-document-editor__toolbar" role="toolbar" aria-label="Rich text editor toolbar">
        <button type="button" class="btn btn-sm btn-outline-secondary" title="Bold" @onclick='@(() => RunEditorCommandAsync("toggleBold"))'>
            <span class="oi oi-bold" aria-hidden="true"></span>
        </button>
        <button type="button" class="btn btn-sm btn-outline-secondary" title="Italic" @onclick='@(() => RunEditorCommandAsync("toggleItalic"))'>
            <span class="oi oi-italic" aria-hidden="true"></span>
        </button>
        <button type="button" class="btn btn-sm btn-outline-secondary" title="Underline" @onclick='@(() => RunEditorCommandAsync("toggleUnderline"))'>
            <span class="oi oi-underline" aria-hidden="true"></span>
        </button>
        <button type="button" class="btn btn-sm btn-outline-secondary" title="Paragraph" @onclick='@(() => RunEditorCommandAsync("setParagraph"))'>P</button>
        <button type="button" class="btn btn-sm btn-outline-secondary" title="Heading 1" @onclick='@(() => RunEditorCommandAsync("toggleHeading1"))'>H1</button>
        <button type="button" class="btn btn-sm btn-outline-secondary" title="Heading 2" @onclick='@(() => RunEditorCommandAsync("toggleHeading2"))'>H2</button>
        <button type="button" class="btn btn-sm btn-outline-secondary" title="Heading 3" @onclick='@(() => RunEditorCommandAsync("toggleHeading3"))'>H3</button>
        <span class="rich-text-document-editor__toolbar-separator" aria-hidden="true"></span>
        <button type="button" class="btn btn-sm btn-outline-secondary" title="Вставить таблицу" @onclick='@(() => RunEditorCommandAsync("insertTable"))'>
            <span class="oi oi-grid-three-up" aria-hidden="true"></span>
        </button>
        <button type="button"
                class="btn btn-sm btn-outline-secondary rich-text-document-editor__toggle-button rich-text-document-editor__table-control rich-text-document-editor__table-control--hidden"
                title="Переключить заголовок таблицы"
                data-rich-text-editor-command="toggleTableHeaderRow"
                data-rich-text-editor-table-control="true"
                aria-pressed="false"
                @onclick='@(() => RunEditorCommandAsync("toggleTableHeaderRow"))'>
            <span class="oi oi-check" aria-hidden="true"></span>
            <span>TH</span>
        </button>
        <button type="button"
                class="btn btn-sm btn-outline-secondary rich-text-document-editor__toggle-button rich-text-document-editor__table-control rich-text-document-editor__table-control--hidden"
                title="Переключить нумерацию строк"
                data-rich-text-editor-command="toggleTableRowNumbers"
                data-rich-text-editor-table-control="true"
                aria-pressed="false"
                @onclick='@(() => RunEditorCommandAsync("toggleTableRowNumbers"))'>№</button>
        <button type="button"
                class="btn btn-sm btn-outline-secondary rich-text-document-editor__toggle-button rich-text-document-editor__table-control rich-text-document-editor__table-control--hidden"
                title="Заливка ячеек"
                data-rich-text-editor-command="openCellBackgroundPalette"
                data-rich-text-editor-table-control="true"
                aria-haspopup="menu"
                @onclick='@(() => RunEditorCommandAsync("openCellBackgroundPalette"))'>
            <span class="rich-text-document-editor__cell-fill-swatch rich-text-document-editor__cell-fill-swatch--empty"
                  data-rich-text-cell-background-swatch
                  aria-hidden="true"></span>
            <span>BG</span>
        </button>
        <button type="button" class="btn btn-sm btn-outline-secondary rich-text-document-editor__table-control rich-text-document-editor__table-control--hidden" title="Добавить строку" data-rich-text-editor-table-control="true" @onclick='@(() => RunEditorCommandAsync("addTableRow"))'>R+</button>
        <button type="button" class="btn btn-sm btn-outline-secondary rich-text-document-editor__table-control rich-text-document-editor__table-control--hidden" title="Удалить строку" data-rich-text-editor-table-control="true" @onclick='@(() => RunEditorCommandAsync("deleteTableRow"))'>R-</button>
        <button type="button" class="btn btn-sm btn-outline-secondary rich-text-document-editor__table-control rich-text-document-editor__table-control--hidden" title="Добавить столбец" data-rich-text-editor-table-control="true" @onclick='@(() => RunEditorCommandAsync("addTableColumn"))'>C+</button>
        <button type="button" class="btn btn-sm btn-outline-secondary rich-text-document-editor__table-control rich-text-document-editor__table-control--hidden" title="Удалить столбец" data-rich-text-editor-table-control="true" @onclick='@(() => RunEditorCommandAsync("deleteTableColumn"))'>C-</button>
        <button type="button" class="btn btn-sm btn-outline-secondary rich-text-document-editor__table-control rich-text-document-editor__table-control--hidden" title="Удалить таблицу" data-rich-text-editor-table-control="true" @onclick='@(() => RunEditorCommandAsync("deleteTable"))'>
            <span class="oi oi-trash" aria-hidden="true"></span>
        </button>
        <span class="rich-text-document-editor__toolbar-separator" aria-hidden="true"></span>
        <button type="button" class="btn btn-sm btn-outline-secondary" title="Embed" @onclick="OpenEmbedPickerAsync">
            <span class="oi oi-link-intact" aria-hidden="true"></span>
            <span>Embed</span>
        </button>

        @if (HasDirtyDrafts)
        {
            <span class="rich-text-document-editor__dirty">Есть несохраненные изменения</span>
        }
    </div>

    <EmbedObjectPicker IsOpen="@IsEmbedPickerOpen"
                       OnClosed="CloseEmbedPickerAsync"
                       OnVideoSelected="InsertVideoAsync"
                       OnVideoFileSelected="InsertUploadingVideoAsync" />

    <div id="@ViewportElementId" class="rich-text-document-editor__viewport" tabindex="0">
        @if (IsInitialContentLoading && LoadedChunks.Count == 0)
        {
            <div class="rich-text-document-editor__loading">Загрузка текста...</div>
        }

        <div class="rich-text-document-editor__spacer" style="@TopSpacerStyle"></div>

        @foreach (var chunk in LoadedChunks)
        {
            <article @key="chunk.Id"
                     class="@GetChunkCssClass(chunk.SortOrder)"
                     data-rich-text-chunk="true"
                     data-rich-text-editor-chunk="true"
                     data-chunk-id="@chunk.Id"
                     data-chunk-sort-order="@chunk.SortOrder">
                <div class="rich-text-document-editor__chunk-meta">
                    <span>Chunk @chunk.SortOrder</span>
                    @if (IsChunkDirty(chunk.SortOrder))
                    {
                        <span class="rich-text-document-editor__chunk-dirty">Dirty</span>
                    }
                </div>
                <div class="rich-text-document-editor__host"
                     data-rich-text-editor-host="true"
                     data-chunk-id="@chunk.Id"
                     data-chunk-sort-order="@chunk.SortOrder">
                </div>
            </article>
        }

        <div class="rich-text-document-editor__spacer" style="@BottomSpacerStyle"></div>
    </div>
</div>
