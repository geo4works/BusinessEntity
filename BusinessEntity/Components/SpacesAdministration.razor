@using BusinessEntity.Core.Classes
@using BusinessEntity.Core.DomainEntities
@using BusinessEntityEntity = BusinessEntity.Core.Classes.BusinessEntity
@using BusinessEntity.Services
@using BusinessEntity.Services.BackupRestore
@inject SpaceHelper SpaceHelper
@inject SpaceBackupService SpaceBackupService
@inject SpaceRestoreService SpaceRestoreService

<div class="card">
    <div class="card-body">
        <h5 class="card-title">Пространства</h5>
        <p class="card-text">
            Создание, переименование и удаление пространств.
        </p>

        <div class="row g-2 align-items-end mb-3">
            <div class="col-md-6">
                <label class="form-label">Импорт backup пространства</label>
                <input class="form-control"
                       @bind="ImportBackupRootPath"
                       @bind:event="oninput"
                       placeholder="Путь к папке backup пространства" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Имя нового пространства</label>
                <input class="form-control"
                       @bind="ImportTargetSpaceName"
                       @bind:event="oninput"
                       placeholder="Можно оставить пустым" />
            </div>
            <div class="col-md-auto">
                <button class="btn btn-outline-primary"
                        @onclick="ImportSpaceBackupAsync"
                        disabled="@IsBusy">
                    Импорт
                </button>
            </div>
        </div>

        <div class="row g-2 align-items-end mb-3">
            <div class="col-md-6">
                <label class="form-label">Новое пространство</label>
                <input class="form-control"
                       @bind="NewSpaceName"
                       @bind:event="oninput"
                       placeholder="Введите имя пространства" />
            </div>
            <div class="col-md-auto">
                <button class="btn btn-primary"
                        @onclick="CreateSpaceAsync"
                        disabled="@IsBusy">
                    Создать
                </button>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(StatusMessage))
        {
            <div class="alert alert-success py-2" role="alert">@StatusMessage</div>
        }

        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="alert alert-danger py-2" role="alert">@ErrorMessage</div>
        }

        @if (IsLoading)
        {
            <div class="text-muted">Загружаем пространства...</div>
        }
        else if (Spaces.Count == 0)
        {
            <div class="text-muted">Пространства пока не созданы.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Имя</th>
                            <th>Создано</th>
                            <th class="text-end">Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var space in Spaces)
                        {
                            <tr>
                                <td>
                                    @if (EditingSpaceId == space.Id)
                                    {
                                        <input class="form-control"
                                               @bind="EditingSpaceName"
                                               @bind:event="oninput" />
                                    }
                                    else
                                    {
                                        <span>@space.Name</span>
                                    }
                                </td>
                                <td>@space.CreatedDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                                <td class="text-end">
                                    @if (DeleteCandidateId == space.Id)
                                    {
                                        <button class="btn btn-sm btn-danger me-2"
                                                @onclick="() => ConfirmDeleteAsync(space.Id)"
                                                disabled="@IsBusy">
                                            Подтвердить удаление
                                        </button>
                                        <button class="btn btn-sm btn-outline-secondary"
                                                @onclick="CancelDelete"
                                                disabled="@IsBusy">
                                            Отмена
                                        </button>
                                    }
                                    else if (EditingSpaceId == space.Id)
                                    {
                                        <button class="btn btn-sm btn-primary me-2"
                                                @onclick="() => SaveRenameAsync(space.Id)"
                                                disabled="@IsBusy">
                                            Сохранить
                                        </button>
                                        <button class="btn btn-sm btn-outline-secondary"
                                                @onclick="CancelEdit"
                                                disabled="@IsBusy">
                                            Отмена
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-outline-primary me-2"
                                                @onclick="() => StartEdit(space)"
                                                disabled="@IsBusy">
                                            Переименовать
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger"
                                                @onclick="() => StartDelete(space.Id)"
                                                disabled="@IsBusy">
                                            Удалить
                                        </button>
                                        <button class="btn btn-sm btn-outline-secondary ms-2"
                                                title="Настройки пространства"
                                                aria-label="Настройки пространства"
                                                aria-expanded="@(ExpandedSettingsSpaceId == space.Id)"
                                                @onclick="() => ToggleSpaceSettings(space)"
                                                disabled="@IsBusy">
                                            <span aria-hidden="true">@(ExpandedSettingsSpaceId == space.Id ? "▴" : "▾")</span>
                                        </button>
                                    }
                                </td>
                            </tr>
                            @if (ExpandedSettingsSpaceId == space.Id)
                            {
                                <tr>
                                    <td colspan="3" class="bg-light">
                                        <div class="border rounded p-3 bg-white">
                                            <fieldset class="border rounded p-3">
                                                <legend class="float-none w-auto px-2 fs-6 mb-0">Бэкап</legend>
                                                <div class="d-flex flex-column gap-3">
                                                    <div class="form-check">
                                                        <input class="form-check-input"
                                                               type="checkbox"
                                                               checked="@GetDraftDoBackup(space.Id)"
                                                               @onchange="args => SetDraftDoBackup(space.Id, args)"
                                                               disabled="@IsBusy" />
                                                        <label class="form-check-label">Делать бэкап</label>
                                                    </div>

                                                    <div>
                                                        <label class="form-label">Папка для бэкапа</label>
                                                        <input class="form-control form-control-sm"
                                                               value="@GetDraftBackupFolder(space.Id)"
                                                               @oninput="args => SetDraftBackupFolder(space.Id, args)"
                                                               placeholder="@GetDisplayBackupFolder(space.Id)"
                                                               title="@GetDisplayBackupFolder(space.Id)"
                                                               disabled="@IsBusy" />
                                                        <div class="form-text">
                                                            Итоговый путь: <code>@GetDisplayBackupFolder(space.Id)</code>
                                                        </div>
                                                    </div>

                                                    <div>
                                                        <label class="form-label">Период, минут</label>
                                                        <input class="form-control form-control-sm"
                                                               type="number"
                                                               min="1"
                                                               step="1"
                                                               value="@GetDraftBackupIntervalMinutes(space.Id)"
                                                               @oninput="args => SetDraftBackupIntervalMinutes(space.Id, args)"
                                                               disabled="@IsBusy" />
                                                    </div>

                                                    <div class="d-flex flex-column gap-2 align-items-start">
                                                        <button class="btn btn-sm btn-outline-primary"
                                                                @onclick="() => RunManualBackupAsync(space.Id)"
                                                                disabled="@(IsBusy || !GetDraftDoBackup(space.Id))">
                                                            Backup
                                                        </button>
                                                        <button class="btn btn-sm btn-outline-danger"
                                                                @onclick="() => ClearBackupAsync(space.Id)"
                                                                disabled="@IsBusy">
                                                            Очистить бэкап
                                                        </button>
                                                        <button class="btn btn-sm btn-primary"
                                                                @onclick="() => SaveSpacePropertiesAsync(space.Id)"
                                                                disabled="@IsBusy">
                                                            Сохранить
                                                        </button>
                                                        <button class="btn btn-sm btn-outline-secondary"
                                                                @onclick="() => CancelSpaceSettings(space.Id)"
                                                                disabled="@IsBusy">
                                                            Отмена
                                                        </button>
                                                    </div>
                                                </div>
                                            </fieldset>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    private readonly List<BusinessEntityEntity> Spaces = new();
    private readonly Dictionary<Guid, GenericSpaceProperties> SpacePropertiesBySpaceId = new();
    private readonly Dictionary<Guid, GenericSpaceProperties> DraftSpacePropertiesBySpaceId = new();
    private bool IsLoading;
    private bool IsBusy;
    private string NewSpaceName { get; set; } = string.Empty;
    private string ImportBackupRootPath { get; set; } = string.Empty;
    private string ImportTargetSpaceName { get; set; } = string.Empty;
    private string EditingSpaceName { get; set; } = string.Empty;
    private Guid? EditingSpaceId { get; set; }
    private Guid? DeleteCandidateId { get; set; }
    private Guid? ExpandedSettingsSpaceId { get; set; }
    private string? StatusMessage { get; set; }
    private string? ErrorMessage { get; set; }

    /// <summary>
    /// Загружает список пространств при инициализации компонента.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        await ReloadSpacesAsync();
    }

    /// <summary>
    /// Создает новое пространство и обновляет список.
    /// </summary>
    private async Task CreateSpaceAsync()
    {
        await RunBusyActionAsync(
            async () =>
            {
                var createdSpace = await SpaceHelper.CreateSpaceAsync(NewSpaceName);
                NewSpaceName = string.Empty;
                StatusMessage = $"Пространство '{createdSpace.Name}' создано.";
                await ReloadSpacesAsync();
            });
    }

    /// <summary>
    /// Импортирует backup пространства в новое пространство.
    /// </summary>
    private async Task ImportSpaceBackupAsync()
    {
        await RunBusyActionAsync(
            async () =>
            {
                if (string.IsNullOrWhiteSpace(ImportBackupRootPath))
                {
                    throw new InvalidOperationException("Укажите путь к папке backup пространства.");
                }

                var result = await SpaceRestoreService.RestoreSpaceAsync(
                    new SpaceRestoreService.SpaceRestoreRequest
                    {
                        BackupRootPath = ImportBackupRootPath,
                        TargetSpaceName = string.IsNullOrWhiteSpace(ImportTargetSpaceName)
                            ? null
                            : ImportTargetSpaceName.Trim(),
                        DisableBackupForRestoredSpace = true
                    });

                ImportBackupRootPath = string.Empty;
                ImportTargetSpaceName = string.Empty;
                StatusMessage = result.Warnings.Count == 0
                    ? $"Backup импортирован в пространство '{result.TargetSpaceName}'. Сущностей: {result.RestoredEntityCount}, отношений: {result.RestoredRelationCount}."
                    : $"Backup импортирован в пространство '{result.TargetSpaceName}'. Сущностей: {result.RestoredEntityCount}, отношений: {result.RestoredRelationCount}, предупреждений: {result.Warnings.Count}.";
                await ReloadSpacesAsync();
            });
    }

    /// <summary>
    /// Переводит строку списка в режим редактирования.
    /// </summary>
    private void StartEdit(BusinessEntityEntity space)
    {
        ResetMessages();
        DeleteCandidateId = null;
        ExpandedSettingsSpaceId = null;
        EditingSpaceId = space.Id;
        EditingSpaceName = space.Name;
    }

    /// <summary>
    /// Сохраняет новое имя пространства.
    /// </summary>
    private async Task SaveRenameAsync(Guid spaceId)
    {
        await RunBusyActionAsync(
            async () =>
            {
                var renamedSpace = await SpaceHelper.RenameSpaceAsync(spaceId, EditingSpaceName);
                EditingSpaceId = null;
                EditingSpaceName = string.Empty;
                StatusMessage = $"Пространство '{renamedSpace?.Name}' переименовано.";
                await ReloadSpacesAsync();
            });
    }

    /// <summary>
    /// Отменяет режим редактирования.
    /// </summary>
    private void CancelEdit()
    {
        EditingSpaceId = null;
        EditingSpaceName = string.Empty;
        ResetMessages();
    }

    /// <summary>
    /// Помечает пространство кандидатом на удаление.
    /// </summary>
    private void StartDelete(Guid spaceId)
    {
        ResetMessages();
        EditingSpaceId = null;
        EditingSpaceName = string.Empty;
        ExpandedSettingsSpaceId = null;
        DeleteCandidateId = spaceId;
    }

    /// <summary>
    /// Подтверждает удаление пространства.
    /// </summary>
    private async Task ConfirmDeleteAsync(Guid spaceId)
    {
        await RunBusyActionAsync(
            async () =>
            {
                var deletedSpace = Spaces.FirstOrDefault(x => x.Id == spaceId);
                await SpaceHelper.DeleteSpaceAsync(spaceId);
                DeleteCandidateId = null;
                ExpandedSettingsSpaceId = null;
                SpacePropertiesBySpaceId.Remove(spaceId);
                DraftSpacePropertiesBySpaceId.Remove(spaceId);
                StatusMessage = $"Пространство '{deletedSpace?.Name ?? spaceId.ToString()}' удалено.";
                await ReloadSpacesAsync();
            });
    }

    /// <summary>
    /// Отменяет удаление пространства.
    /// </summary>
    private void CancelDelete()
    {
        DeleteCandidateId = null;
        ResetMessages();
    }

    /// <summary>
    /// Перезагружает список пространств.
    /// </summary>
    private async Task ReloadSpacesAsync()
    {
        IsLoading = true;
        try
        {
            var spaces = await SpaceHelper.GetSpacesAsync();
            var properties = await SpaceHelper.GetGenericSpacePropertiesAsync(spaces.Select(x => x.Id));

            Spaces.Clear();
            Spaces.AddRange(spaces);
            SpacePropertiesBySpaceId.Clear();
            DraftSpacePropertiesBySpaceId.Clear();
            foreach (var space in spaces)
            {
                SpacePropertiesBySpaceId[space.Id] = CloneSpaceProperties(
                    properties.TryGetValue(space.Id, out var settings)
                        ? settings
                        : new GenericSpaceProperties());
            }

            if (ExpandedSettingsSpaceId.HasValue && !SpacePropertiesBySpaceId.ContainsKey(ExpandedSettingsSpaceId.Value))
            {
                ExpandedSettingsSpaceId = null;
            }

            if (ExpandedSettingsSpaceId.HasValue)
            {
                DraftSpacePropertiesBySpaceId[ExpandedSettingsSpaceId.Value] = CloneSpaceProperties(
                    GetSpaceProperties(ExpandedSettingsSpaceId.Value));
            }
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void ToggleSpaceSettings(BusinessEntityEntity space)
    {
        ResetMessages();
        DeleteCandidateId = null;
        EditingSpaceId = null;
        EditingSpaceName = string.Empty;

        if (ExpandedSettingsSpaceId == space.Id)
        {
            ExpandedSettingsSpaceId = null;
            DraftSpacePropertiesBySpaceId.Remove(space.Id);
            return;
        }

        ExpandedSettingsSpaceId = space.Id;
        DraftSpacePropertiesBySpaceId[space.Id] = CloneSpaceProperties(GetSpaceProperties(space.Id));
    }

    private bool GetDraftDoBackup(Guid spaceId)
    {
        return GetDraftSpaceProperties(spaceId).DoBackup;
    }

    private void SetDraftDoBackup(Guid spaceId, ChangeEventArgs args)
    {
        GetDraftSpaceProperties(spaceId).DoBackup = args.Value switch
        {
            bool value => value,
            string value when bool.TryParse(value, out var parsed) => parsed,
            _ => false
        };
    }

    private string GetDraftBackupFolder(Guid spaceId)
    {
        return GetDraftSpaceProperties(spaceId).BackupFolder;
    }

    private void SetDraftBackupFolder(Guid spaceId, ChangeEventArgs args)
    {
        GetDraftSpaceProperties(spaceId).BackupFolder = args.Value?.ToString() ?? string.Empty;
    }

    private string GetDisplayBackupFolder(Guid spaceId)
    {
        return SpaceBackupService.GetDisplaySpaceBackupFolder(spaceId, GetDraftSpaceProperties(spaceId));
    }

    private int GetDraftBackupIntervalMinutes(Guid spaceId)
    {
        return Math.Max(1, GetDraftSpaceProperties(spaceId).BackupIntervalMinutes);
    }

    private void SetDraftBackupIntervalMinutes(Guid spaceId, ChangeEventArgs args)
    {
        GetDraftSpaceProperties(spaceId).BackupIntervalMinutes =
            int.TryParse(args.Value?.ToString(), out var value) && value > 0
                ? value
                : 1;
    }

    private async Task SaveSpacePropertiesAsync(Guid spaceId)
    {
        await RunBusyActionAsync(
            async () =>
            {
                var settings = await SpaceHelper.SaveGenericSpacePropertiesAsync(
                    spaceId,
                    CloneSpaceProperties(GetDraftSpaceProperties(spaceId)));
                SpacePropertiesBySpaceId[spaceId] = CloneSpaceProperties(settings);
                DraftSpacePropertiesBySpaceId[spaceId] = CloneSpaceProperties(settings);
                StatusMessage = "Настройки пространства сохранены.";
            });
    }

    private async Task RunManualBackupAsync(Guid spaceId)
    {
        await RunBusyActionAsync(
            async () =>
            {
                var settings = await SpaceHelper.SaveGenericSpacePropertiesAsync(
                    spaceId,
                    CloneSpaceProperties(GetDraftSpaceProperties(spaceId)));
                SpacePropertiesBySpaceId[spaceId] = CloneSpaceProperties(settings);
                DraftSpacePropertiesBySpaceId[spaceId] = CloneSpaceProperties(settings);

                var result = await SpaceBackupService.RunManualBackupAsync(spaceId);
                StatusMessage = result.ManifestUpdated
                    ? $"Backup пространства '{result.SpaceName}' выполнен. Обновлено сущностей: {result.ChangedEntityCount}."
                    : $"Backup пространства '{result.SpaceName}' выполнен. Изменений для записи нет.";
            });
    }

    private async Task ClearBackupAsync(Guid spaceId)
    {
        await RunBusyActionAsync(
            async () =>
            {
                var result = await SpaceBackupService.ClearSpaceBackupAsync(
                    spaceId,
                    CloneSpaceProperties(GetDraftSpaceProperties(spaceId)));
                StatusMessage = result.Deleted
                    ? $"Backup очищен: {result.DisplayBackupFolder}"
                    : $"Backup уже пуст: {result.DisplayBackupFolder}";
            });
    }

    private void CancelSpaceSettings(Guid spaceId)
    {
        DraftSpacePropertiesBySpaceId[spaceId] = CloneSpaceProperties(GetSpaceProperties(spaceId));
        ExpandedSettingsSpaceId = null;
        ResetMessages();
    }

    private GenericSpaceProperties GetSpaceProperties(Guid spaceId)
    {
        if (SpacePropertiesBySpaceId.TryGetValue(spaceId, out var settings))
        {
            return settings;
        }

        var defaultSettings = new GenericSpaceProperties();
        SpacePropertiesBySpaceId[spaceId] = defaultSettings;
        return defaultSettings;
    }

    private GenericSpaceProperties GetDraftSpaceProperties(Guid spaceId)
    {
        if (DraftSpacePropertiesBySpaceId.TryGetValue(spaceId, out var settings))
        {
            return settings;
        }

        var draft = CloneSpaceProperties(GetSpaceProperties(spaceId));
        DraftSpacePropertiesBySpaceId[spaceId] = draft;
        return draft;
    }

    private static GenericSpaceProperties CloneSpaceProperties(GenericSpaceProperties settings)
    {
        return new GenericSpaceProperties
        {
            SchemaVersion = settings.SchemaVersion,
            Kind = settings.Kind,
            DoBackup = settings.DoBackup,
            BackupFolder = settings.BackupFolder,
            BackupIntervalMinutes = Math.Max(1, settings.BackupIntervalMinutes)
        };
    }

    /// <summary>
    /// Выполняет UI-действие с общей обработкой busy/error состояния.
    /// </summary>
    private async Task RunBusyActionAsync(Func<Task> action)
    {
        if (IsBusy)
        {
            return;
        }

        try
        {
            IsBusy = true;
            ResetMessages();
            await action();
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsBusy = false;
        }
    }

    /// <summary>
    /// Сбрасывает пользовательские сообщения компонента.
    /// </summary>
    private void ResetMessages()
    {
        StatusMessage = null;
        ErrorMessage = null;
    }
}
