@namespace BusinessEntity.Infrastructure.UI
@using BusinessEntity.Core.Classes
@using BusinessEntity.Core.Saving
@using BusinessEntity.MiniApps.DataProviderMiniApp.Contracts.Connectors
@inject IDataProviderConnector Data
@inject EntitySaveBatchFactory Batches

<details class="entity-version-history mt-3">
    <summary>История версий</summary>
    @if (!string.IsNullOrEmpty(Error)) { <div class="alert alert-danger">@Error</div> }
    <table class="table table-sm">
        <thead><tr><th>Версия</th><th>Название</th><th>Автор</th><th>Дата</th><th></th></tr></thead>
        <tbody>
        @foreach (var version in Versions)
        {
            <tr>
                <td><button class="btn btn-link btn-sm" @onclick="@(() => OnSelected.InvokeAsync(version.Version))">v@(version.Version)</button></td>
                <td>@version.Name</td>
                <td>@(version.SavedByUserId?.ToString("D") ?? "Система")</td>
                <td>@version.CreatedDate.ToLocalTime().ToString("g")</td>
                <td>@if (CanRestore) { <button class="btn btn-outline-secondary btn-sm" disabled="@Busy"
                    @onclick="@(() => RestoreAsync(version.Version))">Восстановить версию</button> }</td>
            </tr>
        }
        </tbody>
    </table>
</details>

@code {
    [Parameter] public Guid EntityId { get; set; }
    [Parameter] public BusinessEntityTypeEnum EntityType { get; set; }
    [Parameter] public bool CanRestore { get; set; }
    [Parameter] public int RefreshToken { get; set; }
    [Parameter] public EventCallback<int> OnSelected { get; set; }
    private IReadOnlyList<BusinessEntityDataVersionInfo> Versions = [];
    private Guid LoadedId;
    private int LoadedToken = -1;
    private bool Busy;
    private string? Error;
    // Обновляет список версий при смене сущности или подтверждённой ревизии.
    protected override async Task OnParametersSetAsync()
    {
        if (LoadedId == EntityId && LoadedToken == RefreshToken) return;
        await LoadAsync(); LoadedId = EntityId; LoadedToken = RefreshToken;
    }
    // Загружает актуальный список версий и показывает явный отказ.
    private async Task LoadAsync()
    {
        try { Versions = await Data.GetDataVersionsAsync(EntityId); Error = null; }
        catch (Exception exception) { Error = exception.Message; }
    }
    // Создаёт новую полную версию выбранного снимка через DataProvider.
    private async Task RestoreAsync(int version)
    {
        if (!CanRestore || Busy) return;
        Busy = true; Error = null;
        try
        {
            var saved = await Data.SaveAsync(Batches.Create(EntityType) with { Restores = [new(EntityId, version)] });
            await LoadAsync(); await OnSelected.InvokeAsync(saved.Versions.Single().Version);
        }
        catch (Exception exception) { Error = exception.Message; }
        finally { Busy = false; }
    }
}
