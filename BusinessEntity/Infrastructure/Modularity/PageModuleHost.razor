@namespace BusinessEntity.Infrastructure.Modularity
@inject WindowModularityManager Manager
@inject IModuleUiFactory UiFactory
@implements IAsyncDisposable

@if (Error != null) { <div class="alert alert-danger" role="alert">@Error</div> }
@if (Module != null)
{
    @if(Manager.GetExecutionError(Module.ModuleId) is { } failure){<div class="alert alert-danger" role="alert">@failure.Message</div>}
    <CascadingValue Value="Module" IsFixed="true" @key="Module.ModuleId">
        <BusinessEntity.Infrastructure.Saving.SaveStateIndicator SaveContext="Module.SaveContext" />
        <DynamicComponent Type="UiFactory.Resolve(Module.Definition.ComponentKey!)" Parameters="Parameters" />
    </CascadingValue>
}

@code {
    [Parameter, EditorRequired] public string DefinitionKey { get; set; } = string.Empty;
    [Parameter] public Guid? ContextId { get; set; }
    [Parameter] public Guid? EditSessionId { get; set; }
    [Parameter] public IDictionary<string, object>? Parameters { get; set; }
    private MiniAppModule? Module;
    private string? Error;
    // Host отображает адресный отказ события, даже когда callback владельца не был допущен.
    protected override void OnInitialized()=>Manager.Changed+=OnManagerChanged;
    // Общий runtime может уведомить вне renderer, поэтому используется owning dispatcher.
    private void OnManagerChanged()=>_ = InvokeAsync(StateHasChanged);
    // URL-host передаёт только контекст; создание и политика принадлежат менеджеру.
    protected override async Task OnParametersSetAsync()
    {
        if (Module?.Definition.Key == DefinitionKey && Module.ContextId == ContextId && (!EditSessionId.HasValue || Module.EditSessionId == EditSessionId)) return;
        if (Module != null) await Manager.CloseAsync(Module.ModuleId);
        Module = null; Error = null;
        try { Module = await Manager.OpenAsync(DefinitionKey, ContextId, EditSessionId); }
        catch (Exception exception) { Error = BusinessEntity.Infrastructure.Bus.BusError.FromException(exception).Message; }
    }
    // Снятие вспомогательного UI не очищает общий dirty рабочего экземпляра.
    public async ValueTask DisposeAsync()
    { Manager.Changed-=OnManagerChanged; if (Module != null) await Manager.ReleaseViewAsync(Module.ModuleId); }
}
