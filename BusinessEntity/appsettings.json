{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "WebLoggerLocalSettings": {
    "HostAliasWhenDocker": "web_logger:80",
    "HostAliasWhenIISExpress": "localhost:5080",
    "ServiceCode": "CTRL"
  },
  "Storage": {
    "RootPath": "App_Data/RichDocumentData"
  },
  "SpaceBackup": {
    "Enabled": true,
    "PollIntervalSeconds": 30
  },
  "ConnectionStrings": {
    "DockerConnection": "Host=postgres-production-db;Port=5432;Database=business_entity;Username=adm01;Password=adm01pwd"
  },
  "Kestrel": {
    "Endpoints": {
      "Http80": {
        "Url": "http://*:80"
      },
      "Http7000": {
        "Url": "http://*:7000"
      }
    }
  },
  "LogEraserSettings": {
    "ErasePeriod": 3000,
    "LogsTargetCount": 90
  },
  "SampleLogSettings": {
    "SampleLogCreatePeriod": 700
  }
}
