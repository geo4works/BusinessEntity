@page "/document/{id:guid}"
@using BusinessEntity.Infrastructure.Modularity
<PageModuleHost DefinitionKey="DocumentsMiniApp:Documents.Document" ContextId="Id" Parameters="ModuleParameters" />

@code {
    [Parameter] public Guid Id { get; set; }
    [SupplyParameterFromQuery(Name = "edit")] public string? EditQuery { get; set; }
    private IDictionary<string, object> ModuleParameters => new Dictionary<string, object> { ["Id"] = Id, ["EditQuery"] = EditQuery ?? string.Empty };
}
