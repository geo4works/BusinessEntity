@page "/print/{id:guid}"
@using BusinessEntity.Infrastructure.Modularity
@layout PrintLayout
<PageModuleHost DefinitionKey="RichTextDocumentMiniApp:RichText.Print" ContextId="Id" Parameters="ModuleParameters" />

@code {
    [Parameter] public Guid Id { get; set; }
    private IDictionary<string, object> ModuleParameters => new Dictionary<string, object> { ["Id"] = Id };
}
