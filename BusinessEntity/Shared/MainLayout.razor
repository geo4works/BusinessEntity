@inherits LayoutComponentBase
@using BusinessEntity.Infrastructure.Modularity

<PageTitle>Business EntityData Engine</PageTitle>

<div class="page">
    <div class="sidebar">
        <ShellModuleHostArea Area="LeftNav" />
    </div>

    <div class="center-area">
        <div class="top-row px-4">
            <div class="app-header"><ShellModuleHostArea Area="TopBar" /></div>
        </div>

        <div class="main-row">
            <div class="tree-panel">
                <div class="tree-content">
                    <ShellModuleHostArea Area="LeftTree" />
                </div>
            </div>

            <main>
                <article class="content px-2">
                    @Body
                </article>
            </main>

            <div class="right-panel">
                <div class="right-header"><h6>Панель настроек и виджетов</h6></div>
                <div class="right-content"><ShellModuleHostArea Area="RightPanel" /></div>
            </div>
        </div>
    </div>
</div>
