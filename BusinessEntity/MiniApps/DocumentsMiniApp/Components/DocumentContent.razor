@namespace BusinessEntity.MiniApps.DocumentsMiniApp.Components
@inherits global::BusinessEntity.Infrastructure.Modularity.ModuleComponentBase

<PageTitle>Document</PageTitle>

@if (!string.IsNullOrEmpty(Error))
{
    <div class="alert alert-danger">@Error</div>
}
else if (IsLoading)
{
    <div class="alert alert-info">Загрузка документа...</div>
}
else if (Entity == null)
{
    <div class="alert alert-warning">Документ не найден.</div>
}
else
{
    <div class="py-2 px-2">
        <Document @ref="DocumentView" Entity="Entity"
                  DataList="DataList"
                  StartInEditMode="StartInEditMode"
                  CanEdit="CanEditDocument"
                  CanBrowseVersions="HasFullDocumentAccess"
                  CanDelete="CanDeleteDocument"
                  CanChangePublicFlag="CanChangePublicFlag"
                  IsPublic="@(Entity?.IsPublic == true)"
                  OnPublicChanged="HandlePublicChangedAsync"
                  OnDeleteRequested="HandleDeleteRequestedAsync" />
    </div>
}
