@namespace BusinessEntity.MiniApps.SpacesMiniApp.Components
@inherits global::BusinessEntity.Infrastructure.Modularity.ModuleComponentBase
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@attribute [AllowAnonymous]
<PageTitle>KMS-Business-Entities-Main</PageTitle>
<AuthorizeView>
    <Authorized>
        <h1>KMS Business EntityData</h1>
        <div class="user-info-container">
            @if (!string.IsNullOrEmpty(CurrentUserName))
            {
                <div class="alert alert-info d-flex justify-content-between align-items-center">
                    <div>
                        <strong>Пользователь:</strong> @CurrentUserName
                        @if (!string.IsNullOrEmpty(CurrentUserId))
                        {
                            <small class="text-muted ms-2">ID: @CurrentUserId</small>
                        }
                    </div>
                    <div>
                        <a href="/authinfo" class="btn btn-outline-primary btn-sm">Подробнее об авторизации</a>
                    </div>
                </div>
            }
        </div>

        @* Информация о выбранных узлах дерева *@
        <div class="selected-nodes-info">
            <div class="alert alert-secondary">
                @if (IsMultiSelectActive)
                {
                    <div class="mt-2">
                        <small class="text-muted">
                            Используйте Ctrl+клик для мульти-селекта. Shift+клик отключен.
                        </small>
                    </div>
                }
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="container mt-5">
            <div class="row justify-content-center">
                <div class="col-md-8">
                    <h1>KMS Business EntityData</h1>
                    @if (IsAnonymousSpacesLoading)
                    {
                        <div class="alert alert-info">
                            <h4>Проверяем публичный доступ</h4>
                            <p>Пожалуйста, подождите.</p>
                        </div>
                    }
                    else if (AnonymousAccessibleSpaces.Count > 0)
                    {
                        <div class="alert alert-info">
                            <h4>Доступно без входа</h4>
                            @if (CurrentAnonymousSpace != null)
                            {
                                <p>Открыто пространство: <strong>@CurrentAnonymousSpace.Name</strong>.</p>
                            }
                            else
                            {
                                <p>Выберите пространство, доступное для просмотра без входа.</p>
                            }

                            @if (AnonymousAccessibleSpaces.Count > 1 || CurrentAnonymousSpace == null)
                            {
                                <div class="list-group mb-3">
                                    @foreach (var space in AnonymousAccessibleSpaces)
                                    {
                                        <button type="button"
                                                class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
                                                @onclick="@(() => SelectAnonymousSpace(space.Id))">
                                            <span>@space.Name</span>
                                            @if (CurrentAnonymousSpace?.Id == space.Id)
                                            {
                                                <span class="badge bg-primary">текущее</span>
                                            }
                                        </button>
                                    }
                                </div>
                            }

                            <button class="btn btn-primary" @onclick="OpenLoginForm">Войти</button>
                        </div>
                    }
                    else
                    {
                        <AuthentikLoginGate />
                    }
                </div>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

<style>
    .user-info-container {
        margin-bottom: 20px;
    }

    .selected-nodes-info {
        margin-bottom: 20px;
    }

    .main-content {
        margin-top: 20px;
    }

    .card {
        margin-bottom: 20px;
    }

    .btn-sm {
        font-size: 0.875rem;
    }

    .lead {
        margin-bottom: 30px;
        text-align: center;
        color: #6c757d;
    }
</style>
