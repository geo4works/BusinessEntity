@namespace BusinessEntity.MiniApps.MediaServerMiniApp.Components
@inherits global::BusinessEntity.Infrastructure.Modularity.ModuleComponentBase
@using BusinessEntity.MiniApps.MediaServerMiniApp.Contracts
@implements IDisposable
@inject IMediaServerUploadJobTracker UploadJobTracker

@if (ActiveJobs.Count > 0)
{
    <div class="widget widget-media-upload">
        <div class="widget-title">Загрузки</div>
        <div class="widget-body widget-media-upload__body">
            @foreach (var job in ActiveJobs)
            {
                <div class="widget-media-upload__job" @key="job.JobId">
                    <div class="widget-media-upload__header">
                        <span class="widget-media-upload__name" title="@job.FileName">@job.FileName</span>
                        <button type="button"
                                class="btn btn-sm btn-outline-danger widget-media-upload__cancel"
                                title="Прервать загрузку"
                                @onclick="() => CancelAsync(job)">
                            <span class="oi oi-x" aria-hidden="true"></span>
                        </button>
                    </div>
                    <div class="widget-media-upload__state">@GetStateText(job)</div>
                    <div class="widget-media-upload__bar">
                        <div class="widget-media-upload__bar-fill" style="width: @GetProgressWidth(job);"></div>
                    </div>
                    <div class="widget-media-upload__numbers">@GetProgressText(job)</div>
                </div>
            }
        </div>
    </div>
}

@code {
    private readonly System.Timers.Timer _timer = new(1000);
    private List<MediaVideoUploadJobInfo> ActiveJobs { get; set; } = new();

    protected override void OnInitialized()
    {
        LoadActiveJobs();
        _timer.Elapsed += OnTimerElapsed;
        _timer.AutoReset = true;
        _timer.Start();
    }

    private void LoadActiveJobs()
    {
        ActiveJobs = UploadJobTracker.GetVideoUploadJobs()
            .Where(IsActive)
            .OrderByDescending(x => x.CreatedDate)
            .ToList();
    }

    private Task CancelAsync(MediaVideoUploadJobInfo job)
    {
        UploadJobTracker.CancelVideoUploadJob(job.JobId);
        LoadActiveJobs();
        return InvokeAsync(StateHasChanged);
    }

    private void OnTimerElapsed(object? sender, System.Timers.ElapsedEventArgs e)
    {
        LoadActiveJobs();
        InvokeAsync(StateHasChanged);
    }

    private static bool IsActive(MediaVideoUploadJobInfo job)
    {
        return job.State == MediaVideoUploadJobState.Queued ||
               job.State == MediaVideoUploadJobState.Uploading ||
               job.State == MediaVideoUploadJobState.Processing;
    }

    private static string GetStateText(MediaVideoUploadJobInfo job)
    {
        return job.State switch
        {
            MediaVideoUploadJobState.Queued => "Ожидает",
            MediaVideoUploadJobState.Uploading => "Загрузка",
            MediaVideoUploadJobState.Processing => "Обработка",
            _ => job.State.ToString()
        };
    }

    private static string GetProgressWidth(MediaVideoUploadJobInfo job)
    {
        var percent = job.ProgressPercent;
        if (!percent.HasValue)
        {
            return job.State == MediaVideoUploadJobState.Processing ? "100%" : "35%";
        }

        return $"{percent.Value:0.##}%";
    }

    private static string GetProgressText(MediaVideoUploadJobInfo job)
    {
        if (!job.TotalBytes.HasValue || job.TotalBytes.Value <= 0)
        {
            return FormatSize(job.UploadedBytes);
        }

        var percent = job.ProgressPercent ?? 0;
        return $"{percent:0}% · {FormatSize(job.UploadedBytes)} из {FormatSize(job.TotalBytes.Value)}";
    }

    private static string FormatSize(long size)
    {
        if (size <= 0)
        {
            return "0 Б";
        }

        string[] suffixes = { "Б", "КБ", "МБ", "ГБ" };
        var value = (double)size;
        var suffixIndex = 0;
        while (value >= 1024 && suffixIndex < suffixes.Length - 1)
        {
            value /= 1024;
            suffixIndex++;
        }

        return suffixIndex == 0
            ? $"{value:0} {suffixes[suffixIndex]}"
            : $"{value:0.0} {suffixes[suffixIndex]}";
    }

    public void Dispose()
    {
        _timer.Stop();
        _timer.Elapsed -= OnTimerElapsed;
        _timer.Dispose();
    }
}
