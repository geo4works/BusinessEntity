@namespace BusinessEntity.MiniApps.DiagnosticsMiniApp.Components
@inherits global::BusinessEntity.Infrastructure.Modularity.ModuleComponentBase
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<PageTitle>Логгинг</PageTitle>

<h1>Логгинг</h1>

<AuthorizeView>
    <Authorized>
        <div class="logging-container">
            <h3>Отправка сообщений в логгер</h3>

            <div class="logging-form">
                <div class="form-group">
                    <label for="logMessage">Сообщение для логгирования:</label>
                    <textarea id="logMessage" class="form-control" rows="4"
                              @bind="LogMessage"
                              placeholder="Введите сообщение для отправки в логгер..."></textarea>
                </div>

                <div class="form-actions">
                    <button class="btn btn-primary" @onclick="SendLogMessage" disabled="@IsLoading">
                        @if (IsLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            <span>Отправка...</span>
                        }
                        else
                        {
                            <span>Отправить</span>
                        }
                    </button>
                    <button class="btn btn-secondary ms-2" @onclick="ClearMessage">
                        Очистить
                    </button>
                </div>

                @if (!string.IsNullOrEmpty(StatusMessage))
                {
                    <div class="alert @AlertClass mt-3">
                        <strong>@StatusLabel</strong> @StatusMessage
                    </div>
                }
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="alert alert-warning">
            <h4>Требуется авторизация</h4>
            <p>Для использования логгинга необходимо войти в систему.</p>
            <button class="btn btn-primary" @onclick="RedirectToLogin">Войти через Authentik</button>
        </div>
    </NotAuthorized>
</AuthorizeView>

<style>
    .logging-container {
        background-color: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 5px;
        padding: 20px;
        margin-bottom: 20px;
        max-width: 800px;
    }

    .logging-container h3 {
        color: #28a745;
        margin-bottom: 20px;
    }

    .logging-form {
        background-color: #fff;
        padding: 20px;
        border-radius: 5px;
        border: 1px solid #dee2e6;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-group label {
        font-weight: 600;
        color: #495057;
        margin-bottom: 8px;
        display: block;
    }

    .form-control {
        border: 1px solid #ced4da;
        border-radius: 4px;
        padding: 10px;
        font-size: 14px;
        transition: border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
    }

    .form-control:focus {
        border-color: #80bdff;
        box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
        outline: 0;
    }

    .form-actions {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .btn {
        padding: 8px 16px;
        border-radius: 4px;
        font-size: 14px;
        font-weight: 500;
        transition: all 0.15s ease-in-out;
    }

    .btn-primary {
        background-color: #007bff;
        border-color: #007bff;
        color: #fff;
    }

    .btn-primary:hover:not(:disabled) {
        background-color: #0056b3;
        border-color: #0056b3;
    }

    .btn-primary:disabled {
        background-color: #6c757d;
        border-color: #6c757d;
        opacity: 0.65;
    }

    .btn-secondary {
        background-color: #6c757d;
        border-color: #6c757d;
        color: #fff;
    }

    .btn-secondary:hover {
        background-color: #545b62;
        border-color: #545b62;
    }

    .spinner-border-sm {
        width: 1rem;
        height: 1rem;
    }

    .alert {
        border-radius: 4px;
        padding: 12px;
        margin-bottom: 0;
    }

    .alert-success {
        background-color: #d4edda;
        border-color: #c3e6cb;
        color: #155724;
    }

    .alert-danger {
        background-color: #f8d7da;
        border-color: #f5c6cb;
        color: #721c24;
    }
</style>
