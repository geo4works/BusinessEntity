@namespace BusinessEntity.MiniApps.UserMiniApp.Components
@inherits global::BusinessEntity.Infrastructure.Modularity.ModuleComponentBase
@using BusinessEntity.MiniApps.UserMiniApp.Internal
@using BusinessEntity.MiniApps.UserMiniApp.Contracts.Dtos
@inject UserAccountsService Accounts
@inject UserFormsWorkingSetFactory WorkingSets
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

<PageTitle>Профиль</PageTitle>
<section class="profile-page">
    <h3>Профиль</h3>
    <EditForm Model="@Model" OnValidSubmit="SaveAsync">
        <label>Отображаемое имя
            <InputText class="form-control" @bind-Value="Model.DisplayedName" @bind-Value:after="Changed" disabled="@Saving" />
        </label>
        <p>Пароль и дополнительные способы входа настраиваются у провайдера учётной записи.</p>
        @if (UserHubNavigation.Resolve(Configuration["UserHub:Url"]) is { } hubUrl)
        {
            <p><a href="@hubUrl" target="_blank" rel="noopener noreferrer">Открыть User Hub — профиль и смена пароля</a></p>
        }
        <button class="btn btn-primary" disabled="@Saving">Сохранить</button>
    </EditForm>
    @if (Error != null) { <p role="alert">@Error</p> }
</section>

@code {
    private UserProfileUpdateRequest Model = new();
    private bool Saving;
    private string? Error;
    private UserFormsWorkingSet Working => WorkingSets.Get(Module!);
    // Форма относится к общему контексту сохранения User, а не к отдельному состоянию компонента.
    protected override async Task OnInitializedAsync()
    {
        var profile = await Accounts.GetProfileAsync() ?? throw new UnauthorizedAccessException();
        Model = Working.Open(UserFormKind.Profile, Guid.Empty, new UserProfileUpdateRequest { DisplayedName = profile.DisplayedName }, profile);
    }
    // Синхронный ввод создаёт новую ревизию до начала Save.
    private void Changed() => Working.Changed(UserFormKind.Profile, Guid.Empty);
    // Подтверждает отправленный снимок стандартным механизмом миниаппа.
    private async Task SaveAsync()
    {
        Saving = true; Error = null;
        try { Changed(); var result = await Module!.SaveContext!.SaveAsync(Module.ModuleId); if (!result.Success) Error = result.Error; }
        catch (Exception exception) { Error = exception.Message; }
        finally { Saving = false; }
    }
}
