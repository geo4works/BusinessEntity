@namespace BusinessEntity.MiniApps.UserMiniApp.Components
@inherits global::BusinessEntity.Infrastructure.Modularity.ModuleComponentBase
@using BusinessEntity.Infrastructure.Identity
@inject UserIdentityService Users
@inject IIdentityProviderRegistry Identity

<PageTitle>Авторизация</PageTitle>
<h1>Авторизация</h1>
@if (Current != null)
{
    <dl>
        <dt>Пользователь</dt><dd>@Current.UserName</dd>
        <dt>Локальный ID</dt><dd>@Current.UserId</dd>
        <dt>Провайдер</dt><dd>@Identity.Current.Profile.Name</dd>
        <dt>Эпоха сессии</dt><dd>@Identity.Current.Epoch</dd>
        <dt>Глобальный администратор</dt><dd>@(Current.IsGlobalAdmin ? "Да" : "Нет")</dd>
    </dl>
    <a href="/auth/logout">Выйти</a>
}
@code {
    private BusinessEntity.MiniApps.UserMiniApp.Contracts.BusinessEntityUser? Current;
    // Диагностика показывает безопасные локальные metadata и не раскрывает токены.
    protected override async Task OnInitializedAsync() => Current = await Users.GetCurrentUserAsync();
}
