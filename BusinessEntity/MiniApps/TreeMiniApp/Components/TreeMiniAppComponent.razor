@inherits global::BusinessEntity.Infrastructure.Modularity.ModuleComponentBase
@using BusinessEntity.MiniApps.TreeMiniApp.Internal.Models
@namespace BusinessEntity.MiniApps.TreeMiniApp.Components
@using Radzen
@using Radzen.Blazor

<style>
    .tree-node-content {
        display: inline-flex;
        align-items: center;
        box-sizing: border-box;
        max-width: 100%;
        min-width: 0;
        overflow: hidden;
        padding: 2px 8px;
        margin: 1px 0;
        border-radius: 6px;
        border: 1px solid transparent;
        color: inherit;
        position: relative;
        transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
        vertical-align: top;
        white-space: nowrap;
    }

    .tree-node-content .rz-icon {
        flex: 0 0 auto;
    }

    .tree-node-icon {
        align-items: center;
        display: inline-flex;
        flex: 0 0 24px;
        height: 24px;
        justify-content: center;
        margin-right: 3px;
        width: 24px;
    }

    .tree-node-icon .rz-icon {
        font-size: 18px !important;
        line-height: 1;
    }

    .tree-node-icon--toggle {
        border-radius: 4px;
        cursor: pointer;
    }

    .tree-node-icon--toggle:hover {
        background: #f4eeff;
        color: #a100ff;
    }

    .tree-node-title {
        display: inline-block;
        flex: 1 1 auto;
        max-width: 100%;
        min-width: 0;
        overflow: hidden;
        text-overflow: clip;
        white-space: nowrap;
    }

    .tree-node-content:hover {
        color: #a100ff !important;
        background-color: transparent !important;
        font-weight: 400 !important;
    }

    .tree-node-selected {
        background-color: #f4eeff !important;
        color: #4b1f73 !important;
        border-radius: 7px;
        padding: 2px 8px;
        margin: 1px 0;
        font-weight: inherit;
        border: 1px solid #ddd0ff;
        outline: none;
    }

    .tree-node-selected:hover {
        background-color: #f4eeff !important;
        color: #a100ff !important;
        border-color: #d3c0ff !important;
        font-weight: 400 !important;
    }

    .tree-node-dragging {
        opacity: 0.5;
        background-color: #ddd !important;
        color: #666 !important;
        cursor: move;
    }

    .tree-node-drag-over {
        background-color: #e3f2fd !important;
        border: 2px dashed #2196f3 !important;
    }

    .tree-multiselect-mode .card-header {
        background-color: #e3f2fd;
        border-bottom: 2px solid #2196f3;
    }

    .rz-treeview-item {
        cursor: pointer;
    }

    #main-tree-container .rz-treeview-item:hover,
    #main-tree-container .rz-treeview-item:active,
    #main-tree-container .rz-treeview-item:focus,
    #main-tree-container .rz-treeview-item.rz-state-highlight,
    #main-tree-container .rz-treeview-item-content:hover,
    #main-tree-container .rz-treeview-item-content:active,
    #main-tree-container .rz-treeview-item-content:focus,
    #main-tree-container .rz-treenode-content:hover,
    #main-tree-container .rz-treenode-content:active,
    #main-tree-container .rz-treenode-content:focus,
    #main-tree-container .rz-treenode-content.rz-state-highlight {
        background: transparent !important;
        background-color: transparent !important;
        box-shadow: none !important;
    }

    #main-tree-container .rz-treenode-content:not(.rz-treenode-content-selected):hover .rz-treenode-label {
        background-color: transparent !important;
        color: #a100ff !important;
        font-weight: 400 !important;
    }

    #main-tree-container .rz-treenode-content:hover .rz-treenode-label {
        color: #a100ff !important;
        font-weight: 400 !important;
    }

    #main-tree-container .rz-treenode-content-selected .rz-treenode-label {
        background-color: transparent !important;
        color: inherit !important;
    }

    /* Убираем фокус outline */
    .rz-treeview-item:focus {
        outline: none !important;
        box-shadow: none !important;
    }

    /* Контроль размеров для элементов дерева */
    .rz-treeview-item-content {
        padding: 2px 4px;
        margin: 0;
        display: inline-block;
        line-height: normal;
        box-sizing: border-box;
        max-width: 100%;
        min-width: 0;
        overflow: hidden;
        white-space: nowrap;
    }

    #main-tree-container .rz-treenode-content,
    #main-tree-container .rz-treenode-label {
        max-width: 100%;
        min-width: 0;
        overflow: hidden;
        white-space: nowrap;
    }

    /* Убираем лишние отступы и обеспечиваем корректную высоту */
    .rz-treeview {
        overflow: visible !important;
        height: auto !important;
        max-height: none !important;
    }

    /* Основной контейнер дерева */
    #main-tree-container {
        overflow: hidden;
        --rz-tree-node-hover-background-color: transparent;
        --rz-tree-node-hover-color: #4b1f73;
        --rz-tree-node-selected-background-color: transparent;
        --rz-tree-node-selected-color: inherit;
        --rz-tree-node-selected-border-radius: 7px;
    }

    /* Card-body должен показывать скролл только при необходимости */
    #main-tree-container .card-body {
        overflow-y: auto;
        overflow-x: hidden;
        padding: 8px;
    }

    /* Стили для заголовка с кнопкой */
    #main-tree-container .card-header {
        background-color: #f8f9fa;
        border-bottom: 1px solid #dee2e6;
        padding: 8px 12px;
        font-size: 12px;
    }

    #main-tree-container .card-header .btn {
        font-size: 11px;
        padding: 2px 6px;
        border-radius: 3px;
    }

    /* Стили для режима редактирования */
    .tree-editing-input {
        border: 2px solid #007bff !important;
        box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25) !important;
        background-color: #fff !important;
    }

    .tree-editing-input:focus {
        border-color: #007bff !important;
        box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25) !important;
        outline: none !important;
    }

    .tree-editing-error {
        border-color: #dc3545 !important;
        box-shadow: 0 0 0 0.2rem rgba(220, 53, 69, 0.25) !important;
    }
</style>

@if (Visible)
{
    <div id="main-tree-container"
         class="card h-100 d-flex flex-column @(IsMultiSelectMode ? "tree-multiselect-mode" : "")"
         style="height: 100%;">

        <!-- Панель заголовка скрыта по требованию -->

        <div class="card-body flex-grow-1">

            @if (TreeData != null && TreeData.Any())
            {
                <RadzenTree Data="@TreeData"
                            Style="width: 100%; height: 100%;"
                            ItemContextMenu="@OnTreeContextMenu"
                            AllowCheckBoxes="false">
                    <RadzenTreeLevel Text="@GetNodeText"
                                     ChildrenProperty="Children"
                                     HasChildren="@NodeHasChildren"
                                     Expanded="@IsNodeExpanded">
                        <Template Context="item">
                            @{
                                var node = item.Value as TreeNodeItemViewModelBase;
                                var cssClasses = new List<string>();
                                if (node?.IsSelected == true)
                                {
                                    cssClasses.Add("tree-node-selected");
                                }
                                if (node?.IsDragging == true)
                                {
                                    cssClasses.Add("tree-node-dragging");
                                }
                                var cssClass = string.Join(" ", cssClasses);
                                bool isEditing = EditingNode == node;
                            }
                            @if (isEditing)
                            {
                                <input type="text"
                                       class="form-control form-control-sm tree-editing-input @(HasValidationError ? "tree-editing-error" : "")"
                                       @bind="EditingText"
                                       @bind:event="oninput"
                                       @onkeydown="OnEditKeyDownAsync"
                                       @onblur="async () => await FinishEditingAsync(true)"
                                       @ref="editingInput"
                                       placeholder="Введите имя папки"
                                       style="display: inline-block; width: auto; min-width: 120px; max-width: 200px;" />
                                @if (HasValidationError)
                                {
                                    <div class="invalid-feedback d-block" style="font-size: 0.75rem; margin-top: 2px;">
                                        @ValidationErrorMessage
                                    </div>
                                }
                            }
                            else
                            {
                                <span class="tree-node-content @cssClass"
                                      draggable="true"
                                      @onmouseover="async (e) => await ShowTreeNodeTooltipAsync(e, node)"
                                      @onmouseleave="async () => await HideTreeNodeTooltipAsync()"
                                      @onclick="async (MouseEventArgs args) => await OnNodeClicked(node, args)"
                                      @onclick:stopPropagation="true"
                                      @onclick:preventDefault="true"
                                      @ondblclick="async () => await OnNodeDoubleClicked(node)"
                                      @ondblclick:stopPropagation="true"
                                      @ondblclick:preventDefault="true"
                                      @ondragstart="async (e) => await OnDragStart(e, node)"
                                      @ondragend="async (e) => await OnDragEnd(e, node)"
                                      @ondragover="async (e) => await OnDragOver(e)"
                                      @ondragover:preventDefault="true"
                                      @ondrop="async (e) => await OnDrop(e, node)"
                                      @ondragenter="(e) => OnDragEnter(e, node)"
                                      @ondragleave="(e) => OnDragLeave(e, node)">
                                    @if (node != null && !string.IsNullOrEmpty(GetNodeIcon(node)))
                                    {
                                        <span class="tree-node-icon @(CanToggleNodeExpansion(node) ? "tree-node-icon--toggle" : "")"
                                              title="@(CanToggleNodeExpansion(node) ? (node.Expanded ? "Закрыть папку" : "Открыть папку") : null)"
                                              @onclick="async () => await ToggleFolderExpandedAsync(node)"
                                              @onclick:stopPropagation="@CanToggleNodeExpansion(node)"
                                              @onclick:preventDefault="@CanToggleNodeExpansion(node)">
                                            <RadzenIcon Icon="@GetNodeIcon(node)" />
                                        </span>
                                    }
                                    <span class="tree-node-title">@node?.Title</span>
                                </span>
                            }
                        </Template>
                    </RadzenTreeLevel>
                </RadzenTree>
            }
            else if (IsLoading)
            {
                <div class="alert alert-info mb-0">
                    <small>Дерево загружается...</small>
                </div>
            }
            else
            {
                <div class="alert alert-warning mb-0">
                    <small>В выбранном пространстве нет данных для отображения</small>
                </div>
            }

        </div>
    </div>

    <RadzenContextMenu />
}

