@using BusinessEntity.Infrastructure.Selection
@namespace BusinessEntity.MiniApps.TreeMiniApp.Components
@inherits global::BusinessEntity.Infrastructure.Modularity.ModuleComponentBase
@inject ReactiveUI.IMessageBus Bus
@implements IDisposable

<div class="widget selection-information">
    <div class="widget-title">Информация</div>
    <div class="widget-body">
        @if (_observer?.Snapshot?.Objects is { Length: > 1 } objects) { <span>Выбрано @objects.Length элементов</span> }
        else if (_observer?.Snapshot?.Objects is { Length: 1 } single)
        {
            var selected = single[0];
            <div class="selection-information__title" data-entity-id="@selected.EntityId">@selected.Title</div>
            <div>Тип: @selected.TypeKey</div>
            @if (selected.CreatedDate.HasValue) { <div>Создан: @selected.CreatedDate.Value.ToLocalTime().ToString("g")</div> }
            @if (selected.ModifiedDate.HasValue) { <div>Изменён: @selected.ModifiedDate.Value.ToLocalTime().ToString("g")</div> }
        }
        else { <span>Ничего не выбрано</span> }
    </div>
</div>
@code {
    private SelectionObserver? _observer;
    private bool _disposed;
    // Helper подписывается на общую шину и запрашивает снимок, если дерево создано раньше.
    protected override void OnInitialized()
    { _observer = new(Bus, ModuleManager, Module!.ModuleId); _observer.Changed += OnSelectionChanged; }
    // Обновляется только owning renderer; callback после снятия UI не выполняется.
    private void OnSelectionChanged() { if (!_disposed) _ = InvokeAsync(() => { if (!_disposed) StateHasChanged(); }); }
    // Никаких scoped selection подписок после завершения компонента не остаётся.
    public void Dispose() { _disposed = true; _observer?.Dispose(); }
}
