@namespace BusinessEntity.MiniApps.SysParametersMiniApp.Components
@inject BusinessEntity.Core.Services.BusinessEntityHelper Entities
@if (!string.IsNullOrWhiteSpace(CompanyName)) { <div class="app-header__company">@CompanyName</div> }
@code {
    private string CompanyName = string.Empty;
    // Обязательные параметры уже созданы startup runtime; ошибка не заменяется пустым объектом.
    protected override async Task OnInitializedAsync()
    {
        var entity = await Entities.GetOrCreateSingletonEntityAsync<BusinessEntity.Core.DomainEntities.SysParameters>(BusinessEntity.Core.Classes.BusinessEntityTypeEnum.SysParametersTp, "SysParameters");
        CompanyName = entity.Data.CompanyName?.Trim() ?? string.Empty;
    }
}
