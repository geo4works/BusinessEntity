@namespace BusinessEntity.MiniApps.SysParametersMiniApp.Components
@inherits global::BusinessEntity.Infrastructure.Modularity.ModuleComponentBase
@using BusinessEntity.Core.Classes
@using BusinessEntity.Core.DomainEntities
@using BusinessEntity.Core.Services
@inject BusinessEntityHelper BusinessEntityHelper

<div class="card">
    <div class="card-body">
        <h5 class="card-title">Общие параметры системы</h5>
        <p class="card-text">
            Настройки сохраняются в отдельный business-объект <code>SysParameters</code> без связей.
        </p>

        @if (IsLoading)
        {
            <div class="text-muted">Загружаем параметры...</div>
        }
        else
        {
            <div class="row g-2 align-items-end">
                <div class="col-md-8">
                    <label class="form-label">Название компании</label>
                    <input class="form-control"
                           @bind="CompanyName"
                           @bind:event="oninput"
                           placeholder="Введите название компании" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Размер rich-text чанка, символов</label>
                    <input class="form-control"
                           type="number"
                           min="1000"
                           step="500"
                           @bind="RichTextChunkCharLimit" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">RichDocument: чанков при открытии</label>
                    <input class="form-control"
                           type="number"
                           min="1"
                           step="1"
                           @bind="RichTextInitialChunkCount" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">RichDocument: чанков перед пунктом содержания</label>
                    <input class="form-control"
                           type="number"
                           min="0"
                           step="1"
                           @bind="RichTextTableOfContentsBeforeBuffer" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">RichDocument: чанков после пункта содержания</label>
                    <input class="form-control"
                           type="number"
                           min="0"
                           step="1"
                           @bind="RichTextTableOfContentsAfterBuffer" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">RichDocument: предыдущих чанков при скролле</label>
                    <input class="form-control"
                           type="number"
                           min="0"
                           step="1"
                           @bind="RichTextScrollPreviousChunkCount" />
                </div>
                <div class="col-md-4">
                    <div class="form-check mt-4">
                        <input class="form-check-input"
                               id="rich-text-hide-toc-scrollbar"
                               type="checkbox"
                               @bind="RichTextHideTableOfContentsScrollbar" />
                        <label class="form-check-label" for="rich-text-hide-toc-scrollbar">
                            Скрывать scrollbar содержания
                        </label>
                    </div>
                </div>
                <div class="col-md-4">
                    <label class="form-label">RichDocument editor: чанков перед фокусом</label>
                    <input class="form-control"
                           type="number"
                           min="0"
                           step="1"
                           @bind="RichTextEditChunksBeforeFocused" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">RichDocument editor: чанков после фокуса</label>
                    <input class="form-control"
                           type="number"
                           min="0"
                           step="1"
                           @bind="RichTextEditChunksAfterFocused" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">RichDocument editor: чанков при открытии</label>
                    <input class="form-control"
                           type="number"
                           min="1"
                           step="1"
                           @bind="RichTextEditChunksOnOpen" />
                </div>
                <div class="col-md-auto">
                    <button class="btn btn-primary"
                            @onclick="SaveSysParametersAsync"
                            disabled="@IsBusy">
                        Сохранить
                    </button>
                </div>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(StatusMessage))
        {
            <div class="alert alert-success py-2 mt-3" role="alert">@StatusMessage</div>
        }

        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="alert alert-danger py-2 mt-3" role="alert">@ErrorMessage</div>
        }
    </div>
</div>

@code {
    private BusinessEntity<SysParameters>? SysParametersEntity { get; set; }
    private bool IsLoading { get; set; }
    private bool IsBusy { get; set; }
    private string CompanyName { get; set; } = string.Empty;
    private int RichTextChunkCharLimit { get; set; } = 12000;
    private int RichTextInitialChunkCount { get; set; } = 2;
    private int RichTextTableOfContentsBeforeBuffer { get; set; } = 2;
    private int RichTextTableOfContentsAfterBuffer { get; set; } = 5;
    private int RichTextScrollPreviousChunkCount { get; set; } = 1;
    private bool RichTextHideTableOfContentsScrollbar { get; set; } = true;
    private int RichTextEditChunksBeforeFocused { get; set; } = 1;
    private int RichTextEditChunksAfterFocused { get; set; } = 1;
    private int RichTextEditChunksOnOpen { get; set; } = 2;
    private string? StatusMessage { get; set; }
    private string? ErrorMessage { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadSysParametersAsync();
    }

    private async Task LoadSysParametersAsync()
    {
        IsLoading = true;
        try
        {
            ErrorMessage = null;
            SysParametersEntity = await BusinessEntityHelper.GetOrCreateSingletonEntityAsync<SysParameters>(
                BusinessEntityTypeEnum.SysParametersTp,
                "SysParameters");

            CompanyName = SysParametersEntity.Data.CompanyName ?? string.Empty;
            RichTextChunkCharLimit = SysParametersEntity.Data.RichTextChunkCharLimit <= 0
                ? 12000
                : SysParametersEntity.Data.RichTextChunkCharLimit;
            RichTextInitialChunkCount = SysParametersEntity.Data.RichTextInitialChunkCount <= 0
                ? 2
                : SysParametersEntity.Data.RichTextInitialChunkCount;
            RichTextTableOfContentsBeforeBuffer = SysParametersEntity.Data.RichTextTableOfContentsBeforeBuffer < 0
                ? 2
                : SysParametersEntity.Data.RichTextTableOfContentsBeforeBuffer;
            RichTextTableOfContentsAfterBuffer = SysParametersEntity.Data.RichTextTableOfContentsAfterBuffer < 0
                ? 5
                : SysParametersEntity.Data.RichTextTableOfContentsAfterBuffer;
            RichTextScrollPreviousChunkCount = SysParametersEntity.Data.RichTextScrollPreviousChunkCount < 0
                ? 1
                : SysParametersEntity.Data.RichTextScrollPreviousChunkCount;
            RichTextHideTableOfContentsScrollbar = SysParametersEntity.Data.RichTextHideTableOfContentsScrollbar;
            RichTextEditChunksBeforeFocused = SysParametersEntity.Data.RichTextEditChunksBeforeFocused < 0
                ? 1
                : SysParametersEntity.Data.RichTextEditChunksBeforeFocused;
            RichTextEditChunksAfterFocused = SysParametersEntity.Data.RichTextEditChunksAfterFocused < 0
                ? 1
                : SysParametersEntity.Data.RichTextEditChunksAfterFocused;
            RichTextEditChunksOnOpen = SysParametersEntity.Data.RichTextEditChunksOnOpen <= 0
                ? 2
                : SysParametersEntity.Data.RichTextEditChunksOnOpen;
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task SaveSysParametersAsync()
    {
        if (IsBusy || SysParametersEntity == null)
        {
            return;
        }

        try
        {
            IsBusy = true;
            StatusMessage = null;
            ErrorMessage = null;

            SysParametersEntity.Name = "SysParameters";
            SysParametersEntity.Data.Name = "SysParameters";
            SysParametersEntity.Data.Tag = BusinessEntityTypeEnum.SysParametersTp.ToString();
            SysParametersEntity.Data.CompanyName = CompanyName?.Trim() ?? string.Empty;
            SysParametersEntity.Data.RichTextChunkCharLimit = RichTextChunkCharLimit < 1000
                ? 1000
                : RichTextChunkCharLimit;
            SysParametersEntity.Data.RichTextInitialChunkCount = RichTextInitialChunkCount <= 0
                ? 1
                : RichTextInitialChunkCount;
            SysParametersEntity.Data.RichTextTableOfContentsBeforeBuffer = RichTextTableOfContentsBeforeBuffer < 0
                ? 0
                : RichTextTableOfContentsBeforeBuffer;
            SysParametersEntity.Data.RichTextTableOfContentsAfterBuffer = RichTextTableOfContentsAfterBuffer < 0
                ? 0
                : RichTextTableOfContentsAfterBuffer;
            SysParametersEntity.Data.RichTextScrollPreviousChunkCount = RichTextScrollPreviousChunkCount < 0
                ? 0
                : RichTextScrollPreviousChunkCount;
            SysParametersEntity.Data.RichTextHideTableOfContentsScrollbar = RichTextHideTableOfContentsScrollbar;
            SysParametersEntity.Data.RichTextEditChunksBeforeFocused = RichTextEditChunksBeforeFocused < 0
                ? 0
                : RichTextEditChunksBeforeFocused;
            SysParametersEntity.Data.RichTextEditChunksAfterFocused = RichTextEditChunksAfterFocused < 0
                ? 0
                : RichTextEditChunksAfterFocused;
            SysParametersEntity.Data.RichTextEditChunksOnOpen = RichTextEditChunksOnOpen <= 0
                ? 1
                : RichTextEditChunksOnOpen;

            await BusinessEntityHelper.SaveEntityAsync(SysParametersEntity);
            StatusMessage = "Параметры системы сохранены.";
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsBusy = false;
        }
    }
}
