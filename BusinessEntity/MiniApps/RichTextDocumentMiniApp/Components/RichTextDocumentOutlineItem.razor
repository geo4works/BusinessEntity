@namespace BusinessEntity.MiniApps.RichTextDocumentMiniApp.Components
@using BusinessEntity.MiniApps.RichTextDocumentMiniApp.Components

<div class="rich-text-outline__item rich-text-outline__item--level-@Node.Level">
    <div class="rich-text-outline__row">
        @if (Node.Children.Count > 0)
        {
            <button type="button"
                    class="rich-text-outline__toggle"
                    @onclick="ToggleExpanded">
                @(Node.IsExpanded ? "▾" : "▸")
            </button>
        }
        else
        {
            <span class="rich-text-outline__toggle rich-text-outline__toggle--placeholder"></span>
        }

        <button type="button"
                class="rich-text-outline__link"
                @onclick="SelectHeadingAsync">
            @Node.Title
        </button>
    </div>

    @if (Node.IsExpanded && Node.Children.Count > 0)
    {
        <div class="rich-text-outline__children">
            @foreach (var child in Node.Children)
            {
                <RichTextDocumentOutlineItem Node="child" OnHeadingSelected="OnHeadingSelected" />
            }
        </div>
    }
</div>

@code {
    [Parameter] public RichTextDocumentOutlineNode Node { get; set; } = default!;
    [Parameter] public EventCallback<RichTextDocumentOutlineNode> OnHeadingSelected { get; set; }

    // Переключает видимость дочерних заголовков текущего узла оглавления.
    private void ToggleExpanded()
    {
        Node.IsExpanded = !Node.IsExpanded;
    }

    // Сообщает родительскому компоненту, к какому заголовку нужно прокрутить viewport документа.
    private Task SelectHeadingAsync()
    {
        return OnHeadingSelected.InvokeAsync(Node);
    }
}
