@namespace BusinessEntity.MiniApps.RichTextDocumentMiniApp.Components
@inherits global::BusinessEntity.Infrastructure.Modularity.ModuleComponentBase

<PageTitle>@PageTitleText</PageTitle>

@((MarkupString)PrintPageStyleMarkup)

<section class="document-print-page" style="@PrintSurfaceStyle">
    <header class="document-print-page__toolbar">
        <div class="document-print-page__toolbar-actions">
            <button type="button"
                    class="document-print-page__toolbar-button"
                    title="Печать на принтер"
                    disabled="@IsPrintCommandDisabled"
                    @onclick="PrintToPrinterAsync">
                <span class="material-icons" aria-hidden="true">print</span>
                <span>Печать на принтер</span>
            </button>

            <button type="button"
                    class="document-print-page__toolbar-button"
                    title="Печать в PDF"
                    disabled="@IsPrintCommandDisabled"
                    @onclick="PrintToPdfAsync">
                <span class="material-icons" aria-hidden="true">picture_as_pdf</span>
                <span>Печать в PDF</span>
            </button>
        </div>

        <div class="document-print-page__settings-panel">
            <div class="document-print-page__settings" aria-label="Настройки печати">
                <label class="document-print-page__setting">
                    <span class="document-print-page__setting-label">Шрифт</span>
                    <span class="document-print-page__setting-control">
                        <input type="number"
                               min="50"
                               max="150"
                               step="5"
                               disabled="@IsPrintSettingsDisabled"
                               @bind="PrintSettings.FontScalePercent" />
                        <span>%</span>
                    </span>
                </label>
                <label class="document-print-page__setting">
                    <span class="document-print-page__setting-label">Верх</span>
                    <span class="document-print-page__setting-control">
                        <input type="number"
                               min="0"
                               max="50"
                               step="1"
                               disabled="@IsPrintSettingsDisabled"
                               @bind="PrintSettings.MarginTopMm" />
                        <span>мм</span>
                    </span>
                </label>
                <label class="document-print-page__setting">
                    <span class="document-print-page__setting-label">Низ</span>
                    <span class="document-print-page__setting-control">
                        <input type="number"
                               min="0"
                               max="50"
                               step="1"
                               disabled="@IsPrintSettingsDisabled"
                               @bind="PrintSettings.MarginBottomMm" />
                        <span>мм</span>
                    </span>
                </label>
                <label class="document-print-page__setting">
                    <span class="document-print-page__setting-label">Лево</span>
                    <span class="document-print-page__setting-control">
                        <input type="number"
                               min="0"
                               max="50"
                               step="1"
                               disabled="@IsPrintSettingsDisabled"
                               @bind="PrintSettings.MarginLeftMm" />
                        <span>мм</span>
                    </span>
                </label>
                <label class="document-print-page__setting">
                    <span class="document-print-page__setting-label">Право</span>
                    <span class="document-print-page__setting-control">
                        <input type="number"
                               min="0"
                               max="50"
                               step="1"
                               disabled="@IsPrintSettingsDisabled"
                               @bind="PrintSettings.MarginRightMm" />
                        <span>мм</span>
                    </span>
                </label>
            </div>

            <div class="document-print-page__presets" aria-label="Пресеты печати">
                <label class="document-print-page__setting document-print-page__preset-select">
                    <span class="document-print-page__setting-label">Пресет</span>
                    <span class="document-print-page__setting-control">
                        <select value="@SelectedPrintPresetName"
                                disabled="@IsPrintSettingsDisabled"
                                @onchange="OnPrintPresetChanged">
                            <option value="">Новый</option>
                            @foreach (var preset in PrintPresets)
                            {
                                <option value="@preset.Name">@preset.Name</option>
                            }
                        </select>
                    </span>
                </label>

                <label class="document-print-page__setting document-print-page__preset-name">
                    <span class="document-print-page__setting-label">Имя</span>
                    <span class="document-print-page__setting-control">
                        <input type="text"
                               maxlength="80"
                               disabled="@IsPrintSettingsDisabled"
                               @bind="PrintPresetName" />
                    </span>
                </label>
            </div>
        </div>

        <button type="button"
                class="document-print-page__save-settings-button"
                title="Сохранить пресет печати"
                disabled="@IsSaveSettingsDisabled"
                @onclick="SavePrintPresetAsync">
            <span class="material-icons" aria-hidden="true">save</span>
            <span>Сохранить</span>
        </button>

        <button type="button"
                class="document-print-page__delete-settings-button"
                title="Удалить пресет печати"
                disabled="@IsDeleteSettingsDisabled"
                @onclick="DeletePrintPresetAsync">
            <span class="material-icons" aria-hidden="true">delete</span>
            <span>Удалить</span>
        </button>

        <button type="button"
                class="document-print-page__close-button"
                title="Закрыть"
                @onclick="CloseAsync">
            <span class="material-icons" aria-hidden="true">close</span>
            <span>Закрыть</span>
        </button>
    </header>

    <main class="document-print-page__body">
        @if (!string.IsNullOrEmpty(Error))
        {
            <div class="document-print-page__message document-print-page__message--error">@Error</div>
        }
        else if (IsLoading)
        {
            <div class="document-print-page__message">Загрузка документа...</div>
        }
        else if (Entity == null)
        {
            <div class="document-print-page__message document-print-page__message--warning">Документ не найден.</div>
        }
        else if (IsRichTextDocument)
        {
            <article class="document-print-page__paper document-print-page__paper--rich">
                <h1 class="document-print-page__title">@Entity.Name</h1>
                @if (IsInitialContentLoading)
                {
                    <div class="document-print-page__message">Загрузка текста...</div>
                }
                else if (InitialChunkWindow == null || InitialChunkWindow.TotalChunkCount == 0)
                {
                    <div class="document-print-page__message">Документ пуст.</div>
                }
                else
                {
                    <RichTextDocumentViewport ViewportElementId="@ViewportElementId"
                                              BusinessEntityId="@Id"
                                              DocumentVersion="@ViewedVersion"
                                              OutlineNodes="@OutlineNodes"
                                              IsInitialContentLoading="@IsInitialContentLoading"
                                              InitialWindow="@InitialChunkWindow" />
                }
            </article>
        }
        else
        {
            <article class="document-print-page__paper">
                <h1 class="document-print-page__title">@Entity.Name</h1>
                @if (string.IsNullOrWhiteSpace(DocumentText))
                {
                    <div class="document-print-page__message">Нет содержимого.</div>
                }
                else
                {
                    <div class="document-print-page__plain-text">@DocumentText</div>
                }
            </article>
        }
    </main>
</section>
